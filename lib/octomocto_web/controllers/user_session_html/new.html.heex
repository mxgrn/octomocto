<Layouts.app
  flash={@flash}
  banners={@banners}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
  guest_unread_notifications={@guest_unread_notifications}
  languages={@languages}
>
  <div class="mx-auto max-w-sm space-y-6 py-10">
    <div class="space-y-2 text-center">
      <h1 class="text-3xl font-semibold tracking-tight">{gettext("Sign in")}</h1>
      <p :if={@current_scope} class="text-base-content/60">
        {gettext("Please sign in again before you change your account.")}
      </p>
    </div>

    <.sign_in_panel current_scope={@current_scope} />
  </div>
</Layouts.app>
