<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm space-y-6 py-10">
    <div class="space-y-2 text-center">
      <h1 class="text-3xl font-semibold tracking-tight">Welcome</h1>
      <p class="text-base-content/60">{@user.email}</p>
    </div>

    <.form
      for={@form}
      id={if(@user.confirmed_at, do: "login_form", else: "confirmation_form")}
      action={if(@user.confirmed_at, do: ~p"/signin", else: ~p"/signin?_action=confirmed")}
      class="space-y-2"
    >
      <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
      <%= if @current_scope do %>
        <button
          id="sign-in-button"
          class="w-full rounded-xl bg-indigo-600 px-4 py-3 font-medium text-white shadow-lg shadow-indigo-600/20 transition hover:-translate-y-0.5 hover:bg-indigo-500 active:translate-y-0"
        >
          Sign in
        </button>
      <% else %>
        <button
          id="remember-me-button"
          name={@form[:remember_me].name}
          value="true"
          class="w-full rounded-xl bg-indigo-600 px-4 py-3 font-medium text-white shadow-lg shadow-indigo-600/20 transition hover:-translate-y-0.5 hover:bg-indigo-500 active:translate-y-0"
        >
          Keep me signed in on this device
        </button>
        <button
          id="sign-in-once-button"
          class="w-full rounded-xl px-4 py-3 font-medium text-indigo-700 ring-1 ring-indigo-200 transition hover:-translate-y-0.5 hover:bg-indigo-50 active:translate-y-0"
        >
          Sign me in only this time
        </button>
      <% end %>
    </.form>
  </div>
</Layouts.app>
