<Layouts.app flash={@flash} notifications={@notifications} current_scope={@current_scope}>
  <div class="mx-auto max-w-sm space-y-6 py-10">
    <div class="space-y-2 text-center">
      <h1 class="text-3xl font-semibold tracking-tight">This link has expired</h1>
      <p class="text-base-content/60">{@form[:email].value}</p>
    </div>

    <.form for={@form} id="resend_link_form" action={~p"/signin"} data-hide-on-submit>
      <input type="hidden" name={@form[:email].name} value={@form[:email].value} />
      <button
        id="resend-link-button"
        class="w-full rounded-xl bg-indigo-600 px-4 py-3 font-medium text-white shadow-lg shadow-indigo-600/20 transition hover:-translate-y-0.5 hover:bg-indigo-500 active:translate-y-0"
      >
        Send me a new link
      </button>
    </.form>
  </div>
</Layouts.app>
