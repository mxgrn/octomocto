<Layouts.app flash={@flash} current_scope={@current_scope}>
  <%!-- Wider than the app container, so that the two columns have room --%>
  <div
    id="schulte-index"
    class="relative left-1/2 grid w-[min(96vw,51rem)] -translate-x-1/2 gap-10 py-12 lg:grid-cols-2 lg:items-start lg:gap-12 lg:py-16"
  >
    <div class="mx-auto flex w-full max-w-md flex-col items-center gap-6 text-center lg:sticky lg:top-8">
      <div class="flex size-20 items-center justify-center rounded-3xl bg-emerald-100 text-3xl font-bold text-emerald-700 shadow-inner tabular-nums">
        1·2·3
      </div>
      <div class="space-y-2">
        <h1 class="text-3xl font-semibold tracking-tight">Schulte Race</h1>
        <p class="text-base-content/70">
          Find the numbers from 1 to 90 in order. The first player to click the next number gets the point.
        </p>
      </div>

      <div id="schulte-settings" class="flex w-full flex-col gap-4">
        <.setting
          label="Board"
          hint={
            if(@board == "classic",
              do: "The board is always the same.",
              else: "The board is new for each game."
            )
          }
        >
          <.option
            :for={{value, label} <- [{"classic", "Classic"}, {"random", "Random"}]}
            id={"board-#{value}"}
            selected={@board == value}
            href={~p"/schulte?#{[board: value, mode: @mode, players: @players]}"}
          >
            {label}
          </.option>
        </.setting>
        <.setting
          label="Mode"
          hint={
            if(@mode == "easy",
              do: "The found numbers disappear.",
              else: "The found numbers stay on the board."
            )
          }
        >
          <.option
            :for={{value, label} <- [{"easy", "Easy"}, {"normal", "Normal"}]}
            id={"mode-#{value}"}
            selected={@mode == value}
            href={~p"/schulte?#{[board: @board, mode: value, players: @players]}"}
          >
            {label}
          </.option>
        </.setting>
        <.setting
          label="Players"
          hint={if(@players > 1, do: "The race starts when all players are in.")}
        >
          <.option
            :for={n <- 1..4}
            id={"players-#{n}"}
            selected={@players == n}
            href={~p"/schulte?#{[board: @board, mode: @mode, players: n]}"}
          >
            {n}
          </.option>
        </.setting>
      </div>

      <.link
        id="new-game"
        href={~p"/schulte?#{[board: @board, mode: @mode, players: @players]}"}
        method="post"
        class="rounded-full bg-emerald-600 px-8 py-3 font-medium text-white shadow-lg shadow-emerald-600/25 transition hover:-translate-y-0.5 hover:bg-emerald-500 hover:shadow-xl active:translate-y-0"
      >
        New game
      </.link>
      <p class="text-sm text-base-content/50">
        You get a link to share with other players.
      </p>
    </div>

    <div id="schulte-leaderboard" class="mx-auto grid w-full max-w-md gap-4">
      <.score_list
        id="your-results"
        icon="hero-user"
        icon_class="text-sky-500"
        title="Your results"
        empty={@user_results != nil and @user_results.latest == []}
      >
        <:aside :if={@user_results && @user_results.best}>
          <span
            id="your-best"
            class="flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3 py-1 text-sm"
          >
            <.icon name="hero-trophy" class="size-3.5 text-amber-500" />
            <span class="text-base-content/60">Best</span>
            <span class="font-semibold tabular-nums">
              {format_time(@user_results.best.elapsed_ms)}
            </span>
          </span>
        </:aside>
        <%= if @user_results do %>
          <li :for={result <- @user_results.latest} class="flex items-baseline gap-3 py-2">
            <span class="flex-1 text-base-content/60">
              {Calendar.strftime(result.inserted_at, "%b %-d")}
            </span>
            <span :if={@players > 1} class="tabular-nums text-base-content/60">
              {result.score} pts
            </span>
            <span class={[
              "w-16 text-right font-medium tabular-nums",
              result.id == @user_results.best.id && "text-amber-600"
            ]}>
              {format_time(result.elapsed_ms)}
            </span>
          </li>
        <% else %>
          <li class="py-2 text-center text-base-content/60">
            <.link
              id="your-results-sign-in"
              href={~p"/signin"}
              class="font-medium text-emerald-600 transition hover:text-emerald-500 hover:underline"
            >
              Sign in
            </.link>
            to see your results.
          </li>
        <% end %>
      </.score_list>
      <.score_list
        id="latest-games"
        icon="hero-clock"
        icon_class="text-emerald-600"
        title="Latest games"
        empty={@leaderboard.latest == []}
      >
        <li :for={game <- @leaderboard.latest} class="flex items-baseline gap-3 py-2">
          <span class="flex-1 truncate">
            {Enum.map_join(game.players, ", ", &player_name(&1.user))}
          </span>
          <span class="font-medium tabular-nums">{format_time(game.elapsed_ms)}</span>
        </li>
      </.score_list>
      <.score_list
        id="best-results"
        icon="hero-trophy"
        icon_class="text-amber-500"
        title="Best results"
        empty={@leaderboard.best == []}
      >
        <li
          :for={{result, place} <- Enum.with_index(@leaderboard.best, 1)}
          class="flex items-baseline gap-3 py-2"
        >
          <span class="w-5 text-right tabular-nums text-base-content/40">{place}</span>
          <span class="flex-1 truncate">{player_name(result.user)}</span>
          <span class="font-medium tabular-nums">{format_time(result.elapsed_ms)}</span>
        </li>
      </.score_list>
    </div>
  </div>
</Layouts.app>
