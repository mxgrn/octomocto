<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="mx-auto flex max-w-xl flex-col gap-8 py-10">
    <section :if={!@current_scope} id="sign-in" class="space-y-3">
      <h1 class="text-3xl font-semibold tracking-tight">Sign in</h1>
      <OctomoctoWeb.UserSessionHTML.sign_in_panel />
    </section>

    <h1 class="text-3xl font-semibold tracking-tight">Games</h1>

    <ul id="games" class="flex flex-col gap-3">
      <li :for={game <- @games}>
        <.link
          id={"game-#{game.id}"}
          navigate={game.path}
          class="group flex items-center gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200 transition hover:-translate-y-0.5 hover:shadow-md hover:ring-slate-300"
        >
          <div class={[
            "flex size-14 shrink-0 items-center justify-center rounded-2xl text-2xl shadow-inner",
            game.icon_class
          ]}>
            {game.icon}
          </div>
          <div class="min-w-0 flex-1">
            <h2 class="font-semibold">{game.name}</h2>
            <p class="text-sm text-base-content/60">{game.description}</p>
          </div>
          <.icon
            name="hero-chevron-right"
            class="size-5 text-base-content/30 transition group-hover:translate-x-0.5 group-hover:text-base-content/60"
          />
        </.link>
      </li>
    </ul>
  </div>
</Layouts.app>
