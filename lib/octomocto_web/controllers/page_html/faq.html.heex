<Layouts.app
  flash={@flash}
  banners={@banners}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
  guest_unread_notifications={@guest_unread_notifications}
  languages={@languages}
>
  <div id="faq" class="mx-auto max-w-2xl space-y-8 py-6 sm:py-10">
    <h1 class="text-3xl font-semibold tracking-tight text-base-content">
      {dgettext("faq", "Frequently asked questions")}
    </h1>

    <nav id="faq-toc" aria-label={dgettext("faq", "Questions")}>
      <ul class="space-y-1">
        <li :for={{id, question} <- faq_questions()}>
          <a
            href={"##{id}"}
            class="group -mx-3 flex items-center gap-2 rounded-lg px-3 py-1.5 text-base-content/70 transition hover:bg-base-200 hover:text-base-content"
          >
            <.icon
              name="hero-chevron-right-mini"
              class="size-4 shrink-0 text-octo-indigo transition group-hover:translate-x-0.5 rtl:rotate-180 rtl:group-hover:-translate-x-0.5 dark:text-octo-indigo-light"
            />
            {question}
          </a>
        </li>
      </ul>
    </nav>

    <.faq_question id="faq-free">
      <p>
        {dgettext(
          "faq",
          "Yes. All games are free, with no ads and no paid features. Octomocto is made by one indie developer, and support on Patreon pays for the servers and the time to make new games."
        )}
      </p>
      <p>
        <.faq_link
          id="faq-donate-link"
          href={OctomoctoWeb.Locale.path(Gettext.get_locale(OctomoctoWeb.Gettext), ~p"/donate")}
        >
          {dgettext("faq", "Support the author")}
        </.faq_link>
      </p>
    </.faq_question>

    <.faq_question id="faq-play-with-friends">
      <p>
        {dgettext(
          "faq",
          "Open a game, set the number of players and click \"Create game\". Then copy the link of the game and send it to your friends. When they open the link, they join your game. Nobody needs an account."
        )}
      </p>
      <p>
        {dgettext(
          "faq",
          "You can also play with other people: join a game from the list of open games on the front page or on the page of a game."
        )}
      </p>
    </.faq_question>

    <.faq_question id="faq-public-private">
      <p>
        {dgettext(
          "faq",
          "When you create a game, you choose \"Public\" or \"Private\". A public game shows in the list of open games until it is full, so anyone can join it. Other people can also watch it while you play."
        )}
      </p>
      <p>
        {dgettext(
          "faq",
          "A private game shows nowhere. Only people with the link can join it."
        )}
      </p>
    </.faq_question>

    <.faq_question id="faq-why-sign-in">
      <p>
        {dgettext(
          "faq",
          "You can play all games as a guest. But a guest exists only in one browser: when you clear its data or open Octomocto on another device, you start again as a new guest. When you sign in, you get these benefits:"
        )}
      </p>

      <ul class="grid gap-3 pt-2 sm:grid-cols-2">
        <.faq_benefit id="faq-devices" icon="hero-device-phone-mobile">
          <:title>{dgettext("faq", "Your progress on all devices")}</:title>
          {dgettext(
            "faq",
            "Sign in on your phone, tablet and computer, and continue where you stopped. Your results, campaign levels and friends go with you."
          )}
        </.faq_benefit>
        <.faq_benefit id="faq-best-results" icon="hero-trophy">
          <:title>{dgettext("faq", "Best results")}</:title>
          {dgettext(
            "faq",
            "Your best results go into the leaderboard of each game. Guest results show only in the latest games."
          )}
        </.faq_benefit>
        <.faq_benefit id="faq-profile" icon="hero-user-circle">
          <:title>{dgettext("faq", "Your name and profile")}</:title>
          {dgettext(
            "faq",
            "Guests get a random name. Choose your own name and a short link to your profile, with your results in all games."
          )}
        </.faq_benefit>
        <.faq_benefit id="faq-friends" icon="hero-users">
          <:title>{dgettext("faq", "Friends")}</:title>
          {dgettext(
            "faq",
            "Play from a shared game link, and you become friends with the player who sent it. See which friends are online and invite them to your game."
          )}
        </.faq_benefit>
        <.faq_benefit id="faq-follow" icon="hero-star">
          <:title>{dgettext("faq", "Follow players")}</:title>
          {dgettext(
            "faq",
            "Follow other players and compare your best results with theirs. Get a notification when someone follows you."
          )}
        </.faq_benefit>
      </ul>

      <p class="pt-2">
        {dgettext(
          "faq",
          "Sign-in is free and takes a few seconds. Sign in with Telegram, or get a sign-in link by email. You do not need a password."
        )}
        <.faq_link href={~p"/privacy"}>
          {dgettext("faq", "We keep as little data as possible.")}
        </.faq_link>
      </p>

      <div :if={!@current_scope} class="pt-2">
        <.link
          id="faq-sign-in"
          href={OctomoctoWeb.Locale.path(Gettext.get_locale(OctomoctoWeb.Gettext), ~p"/signin")}
          class={[
            "inline-flex items-center gap-2 rounded-full px-6 py-3 font-semibold transition",
            "bg-octo-indigo text-white shadow-lg shadow-octo-indigo/30",
            "hover:bg-octo-indigo/90 hover:shadow-xl active:scale-95"
          ]}
        >
          <.icon name="hero-arrow-right-end-on-rectangle" class="size-5 rtl:rotate-180" />
          {dgettext("faq", "Sign in")}
        </.link>
      </div>
    </.faq_question>

    <.faq_question id="faq-friends-follow">
      <p>
        {dgettext(
          "faq",
          "Friends need an account. When you join a game from a link that another player sent you, you two become friends at the end of the game. A game from the list of open games does not make friends, because there you play with strangers."
        )}
      </p>
      <p>
        {dgettext(
          "faq",
          "You can also follow any player: click \"Follow\" on their profile. A follow is one-way. It adds the player to the \"Following\" filter of the best results, so you can compare your results with theirs. When two players follow each other, they are friends too."
        )}
      </p>
      <p>
        {dgettext(
          "faq",
          "Only friends see when you are online, and only friends can invite you to a game."
        )}
      </p>
    </.faq_question>

    <.faq_question id="faq-suggest">
      <p>
        {dgettext(
          "faq",
          "Yes, please! Send an email with your idea or with the steps that cause the bug. You can also click \"Suggest a game\" in the menu."
        )}
      </p>
      <p>
        <.faq_link id="faq-email-link" href="mailto:hi@octomocto.com">hi@octomocto.com</.faq_link>
      </p>
    </.faq_question>
  </div>
</Layouts.app>
