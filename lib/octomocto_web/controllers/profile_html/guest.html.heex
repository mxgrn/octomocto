<Layouts.app
  flash={@flash}
  banners={@banners}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
  guest_unread_notifications={@guest_unread_notifications}
>
  <OctomoctoWeb.UserSessionHTML.guest_page title="Profile">
    Sign in to get your profile page with your best results, and to keep them on all your devices.
  </OctomoctoWeb.UserSessionHTML.guest_page>
</Layouts.app>
