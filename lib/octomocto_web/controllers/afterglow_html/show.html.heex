<Layouts.app flash={@flash} current_scope={@current_scope} wide game>
  <:bar>
    {live_render(@conn, OctomoctoWeb.GameBarLive,
      id: "game-bar-live",
      session: %{"kind" => "afterglow", "id" => @id, "locale" => @locale}
    )}
  </:bar>
  <div
    id="afterglow-main"
    data-game-id={@id}
    data-user-token={@user_token}
    data-settings-url={@settings_path}
    data-next-game-name={@next_game.name}
    data-next-game-path={@next_game.path}
  >
  </div>
</Layouts.app>
