<Layouts.app flash={@flash} current_scope={@current_scope} wide game compact_until_xl>
  <:game_notices>
    {live_render(@conn, OctomoctoWeb.GameNoticesLive,
      id: "game-notices-live",
      session: %{"locale" => @locale}
    )}
  </:game_notices>
  <div
    id="nimble-mosaic-main"
    data-game-id={@id}
    data-user-token={@user_token}
    data-settings-url={@settings_path}
    data-change-settings-url={@change_settings_path}
    data-next-game-name={@next_game.name}
    data-next-game-path={@next_game.path}
  >
  </div>
</Layouts.app>
