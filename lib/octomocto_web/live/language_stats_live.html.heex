<Layouts.app
  notices={@notices}
  flash={@flash}
  games_played={@games_played}
  banners={@banners}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
  guest_unread_notifications={@guest_unread_notifications}
>
  <% most = @games |> Enum.map(& &1.count) |> Enum.max(fn -> 0 end) %>

  <div id="language-stats" class="mx-auto flex w-full max-w-2xl flex-col gap-6 pt-2 pb-4">
    <div>
      <div class="flex items-center justify-between gap-4">
        <.link
          navigate={StatsLive.stats_path(~p"/stats", @today?, @days)}
          id="language-stats-back"
          class="inline-flex items-center gap-1 text-sm text-base-content/60 transition hover:text-octo-indigo dark:hover:text-octo-indigo-light"
        >
          <.icon name="hero-arrow-left" class="size-4" /> Stats
        </.link>
        <div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2">
          <StatsLive.days_tabs
            days={@days}
            today?={@today?}
            path={~p"/stats/languages/#{@language}"}
          />
          <StatsLive.today_toggle
            on={@today?}
            days={@days}
            path={~p"/stats/languages/#{@language}"}
          />
        </div>
      </div>
      <h1 class="mt-3 text-2xl font-semibold tracking-tight text-octo-navy dark:text-base-content">
        {@language}
      </h1>
      <p class="mt-1 text-sm text-base-content/60">
        Games in {StatsLive.period_text(@today?, @days)} with players of this browser language.
      </p>
    </div>

    <section
      id="language-games"
      class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-base-content/10 dark:bg-base-100 sm:p-6"
    >
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 class="font-semibold text-octo-navy dark:text-base-content">Top games</h2>
        <span :if={@games != []} class="text-xs text-base-content/50">{StatsLive.period_label(
          @today?,
          @days
        )}</span>
      </div>
      <p :if={@games == []} id="language-games-empty" class="text-sm text-base-content/60">
        No games yet.
      </p>
      <ul :if={@games != []} class="flex flex-col gap-3">
        <li
          :for={game <- @games}
          id={"language-game-#{game.id}"}
          class="flex items-center gap-3"
        >
          <div class={[
            "flex size-9 shrink-0 items-center justify-center rounded-xl",
            game.icon_class
          ]}>
            <GameIcons.game_icon game={game.id} class="size-7" />
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-4 text-sm">
              <.link
                navigate={StatsLive.stats_path(~p"/stats/#{game.id}", @today?, @days)}
                class="font-medium text-octo-navy transition hover:text-octo-indigo dark:text-base-content dark:hover:text-octo-indigo-light"
              >
                {game.name}
              </.link>
              <span class="flex items-center gap-3">
                <PlayerLive.sparkline
                  id={"language-activity-#{game.id}"}
                  days={game.days}
                />
                <span class="min-w-[4ch] text-right font-semibold text-octo-navy tabular-nums dark:text-base-content">
                  {game.count}
                </span>
              </span>
            </div>
            <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-base-content/5">
              <div
                class="h-full rounded-full bg-octo-indigo dark:bg-octo-indigo-light"
                style={"width: #{if most > 0, do: game.count / most * 100, else: 0}%"}
              >
              </div>
            </div>
          </div>
        </li>
      </ul>
    </section>
  </div>
</Layouts.app>
