<Layouts.app
  notices={@notices}
  flash={@flash}
  games_played={@games_played}
  notifications={@notifications}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
>
  <%!--
    Wider than the app container, so that the columns have room. One column
    on a small screen: the title, the public games, the settings and the
    results. Two columns on a large screen: the results go to the right.
    Three columns on an extra large screen: the public games go to the left,
    and the settings in the center are wider than the other columns. The
    columns use the full width of the screen, with the side padding of the
    header.
    The last row takes the free height, so that the tall results column does
    not make gaps between the rows on the left.
  --%>
  <div
    id="overlap-index"
    class="relative left-1/2 grid w-[min(96vw,51rem)] -translate-x-1/2 gap-6 pt-4 pb-12 lg:grid-cols-2 lg:grid-rows-[auto_auto_1fr] lg:items-start lg:gap-x-12 lg:pt-6 lg:pb-16 xl:w-[calc(100vw-4rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_minmax(0,1fr)] xl:grid-rows-[auto_1fr]"
  >
    <div class="mx-auto w-full max-w-md space-y-2 text-center lg:col-start-1 lg:row-start-1 xl:col-start-2 xl:max-w-none">
      <div class="flex items-center justify-center gap-3">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-octo-indigo/10 shadow-inner">
          <OctomoctoWeb.GameIcons.game_icon game="overlap" class="size-9" />
        </div>
        <h1 class="text-3xl font-semibold tracking-tight">Overlap</h1>
      </div>
      <p class="text-base-content/70">
        A Dobble-like game: spot the one symbol that two cards share.
        Choose the settings and start a new game.
      </p>
      <.how_to_play />
    </div>

    <div
      id="overlap-lobby"
      class="mx-auto grid w-full max-w-md gap-4 lg:col-start-1 lg:row-start-2 xl:row-span-2 xl:row-start-1 xl:max-w-none"
    >
      <.lobby_games
        games={@lobby_games}
        watchers={@watchers}
        matches={&same_settings?(&1, @settings)}
        path={&~p"/overlap/#{&1.id}"}
      >
        <:icon :let={game}>
          <img src={lobby_cover_path(game)} alt="" class="size-9 shrink-0" />
        </:icon>
        <:summary :let={game}>{game_summary(game)}</:summary>
      </.lobby_games>
    </div>

    <div class="mx-auto flex w-full max-w-md flex-col items-center gap-6 text-center lg:sticky lg:top-8 lg:col-start-1 lg:row-start-3 xl:col-start-2 xl:row-start-2 xl:max-w-none">
      <div id="overlap-settings" class="flex w-full flex-col gap-4">
        <.setting
          id="setting-players"
          label="Players"
          icon="hero-users"
          hint={players_hint(@settings.players)}
        >
          <.option
            :for={n <- 1..4}
            id={"players-#{n}"}
            selected={@settings.players == n}
            patch={~p"/overlap?#{query(@settings, players: n)}"}
          >
            {n}
          </.option>
        </.setting>
        <div
          id="setting-theme"
          class="rounded-2xl bg-base-100 p-5 shadow-sm ring-1 ring-base-content/10"
        >
          <%!--
            Random is a switch next to the header, as on the Memory page.
            The game picks the theme when it starts, and again for each new
            deck. Off, the switch goes back to the last chosen theme.
          --%>
          <div class="flex items-center justify-between gap-2">
            <.setting_header label="Theme" icon="hero-swatch" />
            <.link
              id="theme-random"
              patch={
                ~p"/overlap?#{query(@settings, theme: if(@settings.theme == "random", do: @last_theme, else: "random"))}"
              }
              role="switch"
              aria-checked={to_string(@settings.theme == "random")}
              class="group flex items-center gap-2 text-sm font-medium text-base-content/70 transition hover:text-base-content"
            >
              <img
                src={~p"/images/memory/random.svg"}
                alt=""
                class="size-6 transition duration-300 group-hover:scale-110 group-hover:-rotate-12"
              /> Random
              <span class={[
                "relative h-6 w-10 shrink-0 rounded-full transition-colors duration-200",
                if(@settings.theme == "random",
                  do: "bg-octo-indigo",
                  else: "bg-base-content/20 group-hover:bg-base-content/30"
                )
              ]}>
                <span class={[
                  "absolute top-0.5 start-0.5 size-5 rounded-full bg-white shadow-sm transition-transform duration-200 ease-out group-active:scale-90",
                  @settings.theme == "random" && "translate-x-4 rtl:-translate-x-4"
                ]} />
              </span>
            </.link>
          </div>
          <p
            :if={@settings.theme == "random"}
            id="theme-random-hint"
            class="mt-1.5 text-start text-xs text-base-content/50"
          >
            A new theme for each game.
          </p>
          <div
            :if={@settings.theme != "random"}
            id="overlap-themes"
            class="mt-3 grid grid-cols-4 gap-3 xl:grid-cols-6"
          >
            <.link
              :for={theme <- @themes}
              id={"theme-#{theme.name}"}
              patch={~p"/overlap?#{query(@settings, theme: theme.name)}"}
              aria-current={@settings.theme == theme.name && "true"}
              class={[
                "group flex flex-col items-center gap-1 rounded-xl p-1.5 transition",
                if(@settings.theme == theme.name,
                  do: "bg-octo-mist ring-2 ring-octo-indigo dark:bg-octo-indigo-light/10",
                  else: "ring-1 ring-base-content/5 hover:bg-base-200 hover:ring-base-content/15"
                )
              ]}
            >
              <img
                src={cover_path(theme)}
                alt=""
                class="aspect-square w-full p-1 transition group-hover:scale-105"
              />
              <span class="w-full truncate text-xs text-base-content/70">{theme.title}</span>
            </.link>
          </div>
        </div>
        <.setting
          id="setting-visibility"
          label="Visibility"
          icon="hero-eye"
          hint={visibility_hint(@settings)}
        >
          <.option
            :for={
              {value, public, label} <- [
                {"public", true, "Public"},
                {"private", false, "Private"}
              ]
            }
            id={"visibility-#{value}"}
            selected={@settings.public == public}
            patch={~p"/overlap?#{query(@settings, public: public)}"}
          >
            {label}
          </.option>
        </.setting>
      </div>

      <.start_bar multiplayer={@settings.players > 1} />
    </div>

    <div
      id="overlap-leaderboard"
      class="mx-auto grid w-full max-w-md gap-4 lg:col-start-2 lg:row-span-3 lg:row-start-1 xl:col-start-3 xl:row-span-2 xl:max-w-none"
    >
      <.score_list
        id="your-results"
        icon="hero-user"
        icon_class="text-octo-indigo"
        title="Your results"
        empty={@user_results != nil and @user_results.latest == []}
        empty_text="No games yet."
      >
        <:aside :if={@user_results && @user_results.best}>
          <span
            id="your-best"
            class="flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3 py-1 text-sm"
          >
            <.icon name="hero-trophy" class="size-3.5 text-amber-500" />
            <span class="text-base-content/60">Best</span>
            <span class="font-semibold tabular-nums">
              {format_time(@user_results.best.elapsed_ms)}
            </span>
          </span>
        </:aside>
        <%= if @user_results do %>
          <.result_row :for={%{result: result, players: players} <- @user_results.latest}>
            <span :if={@settings.players == 1} class="flex-1 font-medium">
              {Calendar.strftime(result.inserted_at, "%b %-d")}
            </span>
            <span :if={@settings.players > 1} class="min-w-0 flex-1 font-medium">
              <.player_list players={players} scores />
            </span>
            <.result_pill best={@user_results.best != nil and result.id == @user_results.best.id}>
              {format_time(result.elapsed_ms)}
            </.result_pill>
          </.result_row>
        <% else %>
          <li class="py-2 text-center text-base-content/60">
            <.link
              id="your-results-sign-in"
              href={~p"/signin"}
              class="font-medium text-octo-indigo transition hover:text-octo-indigo/80 hover:underline"
            >
              Sign in
            </.link>
            to start saving your results.
          </li>
        <% end %>
      </.score_list>
      <.score_list
        id="best-results"
        icon="hero-trophy"
        icon_class="text-amber-500"
        title="Best results"
        empty={@best_results == []}
        empty_text={OctomoctoWeb.BestResults.empty_text(@best_following)}
      >
        <:aside :if={@user_results}>
          <OctomoctoWeb.BestResults.filter following={@best_following} />
        </:aside>
        <:aside :if={!@user_results}>
          <span class="text-sm text-base-content/60">
            <.link
              id="best-results-sign-in"
              href={~p"/signin"}
              class="font-medium text-octo-indigo transition hover:text-octo-indigo/80 hover:underline"
            >
              Sign in
            </.link>
            to get listed
          </span>
        </:aside>
        <.result_row :for={{result, place} <- Enum.with_index(@best_results, 1)}>
          <span class="w-4 shrink-0 text-right tabular-nums text-base-content/40">{place}</span>
          <span class="min-w-0 flex-1 truncate font-medium"><.player_link player={result.user}>{player_name(
            result.user
          )}</.player_link></span>
          <.result_pill>{format_time(result.elapsed_ms)}</.result_pill>
        </.result_row>
      </.score_list>
    </div>
  </div>

  <.rules rules={@rules} />
</Layouts.app>
