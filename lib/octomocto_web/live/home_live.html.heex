<Layouts.app
  notices={@notices}
  flash={@flash}
  notifications={@notifications}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
  home
  wide
  games_played={@games_played}
>
  <%!-- Soft brand-colored light behind the page --%>
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-octo-mist via-white to-white dark:from-base-300 dark:via-base-100 dark:to-base-100">
    </div>
    <div class="absolute -top-32 left-1/2 size-[28rem] -translate-x-[85%] rounded-full bg-octo-orange/10 blur-3xl dark:bg-octo-orange-light/10">
    </div>
    <div class="absolute top-24 left-1/2 size-[28rem] -translate-x-[15%] rounded-full bg-octo-indigo/10 blur-3xl dark:bg-octo-indigo-light/10">
    </div>
  </div>

  <div class="flex flex-col gap-8 pt-2 pb-4">
    <%!--
      One column on a small screen: the games, then the public
      games. From a small screen, the public games go to the left,
      with the same width as the games (one column of cards). From a
      wide screen, the games get the wider column on the right.
    --%>
    <div class="grid gap-8 sm:grid-cols-2 sm:items-start xl:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-10">
      <section id="catalog" class="sm:col-start-2 sm:row-start-1">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
          <h2
            id="catalog-title"
            class="text-2xl font-semibold tracking-tight text-octo-navy dark:text-base-content"
          >
            What are we playing today?
          </h2>
        </div>
        <%!-- One tag at a time; "all" clears the filter --%>
        <nav id="game-tags" aria-label="Filter games" class="mb-6 flex flex-wrap gap-2">
          <.link
            :for={tag <- [nil | @tags]}
            id={"game-tag-#{tag || "all"}"}
            patch={if(tag, do: ~p"/?tag=#{tag}", else: ~p"/")}
            replace
            aria-current={if(tag == @tag, do: "true")}
            class={[
              "rounded-full px-3.5 py-1.5 text-sm font-medium shadow-sm ring-1 transition active:scale-95",
              if(tag == @tag,
                do:
                  "bg-octo-indigo text-white ring-octo-indigo dark:bg-octo-indigo-light dark:text-octo-navy dark:ring-octo-indigo-light",
                else:
                  "bg-base-100 text-octo-navy/70 ring-base-content/10 hover:text-octo-navy hover:ring-octo-indigo/40 dark:text-base-content/70 dark:hover:text-base-content dark:hover:ring-octo-indigo-light/40"
              )
            ]}
          >
            {tag || "all"}
          </.link>
        </nav>
        <ul
          id="games"
          class="grid grid-cols-1 gap-4 xl:grid-cols-2 2xl:grid-cols-3"
        >
          <li :for={game <- @games}>
            <.link
              id={"game-#{game.id}"}
              navigate={game.path}
              class="group relative flex h-full flex-col gap-2 rounded-3xl bg-octo-indigo/[0.10] p-4 transition-colors hover:bg-octo-indigo/[0.17] dark:bg-octo-indigo-light/10 dark:hover:bg-octo-indigo-light/[0.17]"
            >
              <span
                :if={game[:badge]}
                id={"game-badge-#{game.id}"}
                class={[
                  "absolute -top-2 -right-2 z-10 inline-flex items-center gap-1 whitespace-nowrap rounded-full py-1 pr-2 pl-1.5 text-[11px] leading-none font-semibold tracking-wide text-white uppercase shadow-sm",
                  if(elem(game.badge, 0) == "New", do: "bg-octo-orange", else: "bg-octo-indigo")
                ]}
              >
                <.icon name={elem(game.badge, 1)} class="size-3" />
                {elem(game.badge, 0)}
              </span>
              <div class="flex min-w-0 items-center gap-3">
                <%!-- A solid base, so the tint of the icon does not mix with the tint of the card --%>
                <div class="shrink-0 rounded-2xl bg-base-100">
                  <.game_icon game={game} />
                </div>
                <h3 class="font-semibold text-octo-navy dark:text-base-content">{game.name}</h3>
                <%!-- A hint that friends can play this game together --%>
                <span
                  :if={!game[:single_player]}
                  id={"game-multiplayer-#{game.id}"}
                  class="group/tip relative ml-auto flex shrink-0 text-octo-navy/25 transition group-hover:text-octo-indigo/70 dark:text-base-content/25 dark:group-hover:text-octo-indigo-light/80"
                >
                  <.icon name="hero-user-group" class="size-5" />
                  <%!-- The tooltip; screen readers read it too --%>
                  <span class="pointer-events-none absolute right-0 bottom-full z-20 mb-1.5 rounded-md bg-octo-navy px-2 py-1 text-xs whitespace-nowrap text-white opacity-0 shadow-sm transition group-hover/tip:opacity-100 dark:bg-base-300 dark:text-base-content">
                    Solo or with friends
                  </span>
                </span>
              </div>
              <p class="text-sm text-octo-navy/60 dark:text-base-content/60">
                {game.description}
              </p>
            </.link>
          </li>
        </ul>
      </section>

      <div id="lobby" class="grid grid-cols-1 gap-4 sm:col-start-1 sm:row-start-1">
        <.lobby_games games={@lobby_games} watchers={@watchers} path={&game_path/1}>
          <:action>
            <%!-- The hook plays a sound for a new open game, see lobby_sounds.js --%>
            <button
              id="lobby-sound"
              type="button"
              phx-hook="LobbySound"
              phx-update="ignore"
              aria-pressed="false"
              aria-label="Sound for new games"
              class={[
                "group -my-1 flex size-8 items-center justify-center rounded-full transition",
                "text-base-content/40 hover:bg-base-200 hover:text-base-content/70 active:scale-90",
                "aria-pressed:text-octo-indigo aria-pressed:hover:text-octo-indigo dark:aria-pressed:text-octo-indigo-light"
              ]}
            >
              <.icon name="hero-bell-slash" class="size-5 group-aria-pressed:hidden" />
              <.icon name="hero-bell-alert" class="hidden size-5 group-aria-pressed:block" />
            </button>
          </:action>
          <%!-- A game with themes shows the cover of its theme --%>
          <:icon :let={game}>
            <img
              :if={game.kind == "memory"}
              src={~p"/images/memory/#{game.settings.theme}/#{Themes.cover(game.settings.theme)}"}
              alt=""
              class="size-9 shrink-0"
            />
            <img
              :if={game.kind == "overlap"}
              src={OverlapLive.lobby_cover_path(game)}
              alt=""
              class="size-9 shrink-0"
            />
            <.game_icon
              :if={game.kind not in ["memory", "overlap"]}
              game={@kinds[game.kind]}
              small
            />
          </:icon>
          <:summary :let={game}>
            <.link
              id={"lobby-game-name-#{game.id}"}
              navigate={@kinds[game.kind].path}
              class="font-semibold transition hover:text-octo-indigo dark:hover:text-octo-indigo-light"
            >
              {@kinds[game.kind].name}
            </.link>
            <span :if={game_summary(game)} class="text-base-content/60">
              · {game_summary(game)}
            </span>
          </:summary>
        </.lobby_games>

        <section
          id="friends-online"
          class="rounded-2xl bg-base-100 p-5 shadow-sm ring-1 ring-base-content/10"
        >
          <h3 class="mb-3 flex items-center gap-2 font-semibold">
            <.icon name="hero-heart" class="size-4 text-octo-indigo" /> Friends online
          </h3>
          <%= cond do %>
            <% @friends == nil -> %>
              <p id="friends-online-guest" class="py-2 text-center text-sm text-base-content/60">
                <.link
                  id="friends-online-sign-in"
                  href={~p"/signin"}
                  class="font-medium text-octo-indigo transition hover:text-octo-indigo/80 dark:text-octo-indigo-light"
                >
                  Sign in
                </.link>
                to see when your friends are online. You become friends when you finish a game from a link that one of you shared.
              </p>
            <% @friends_online == [] -> %>
              <p id="friends-online-empty" class="py-2 text-center text-sm text-base-content/50">
                No friends online. You become friends when you finish a game from a link that one of you shared.
              </p>
            <% true -> %>
              <ul id="friends-online-list" class="-mx-2 space-y-1">
                <li
                  :for={friend <- @friends_online}
                  id={"friend-online-#{friend.id}"}
                  phx-mounted={
                    JS.transition(
                      {"ease-out duration-300", "opacity-0 translate-y-1",
                       "opacity-100 translate-y-0"}
                    )
                  }
                  class="flex items-center gap-3 rounded-xl px-2 py-2 transition-colors hover:bg-base-200/60"
                >
                  <span class="relative shrink-0">
                    <img
                      :if={friend.avatar_url}
                      src={friend.avatar_url}
                      alt=""
                      class="size-9 rounded-full object-cover"
                    />
                    <span
                      :if={!friend.avatar_url}
                      class="flex size-9 items-center justify-center rounded-full bg-octo-indigo/10 font-semibold text-octo-indigo dark:bg-octo-indigo-light/15 dark:text-octo-indigo-light"
                    >
                      {String.first(friend.name || "?") |> String.upcase()}
                    </span>
                    <%!-- Online --%>
                    <span class="absolute -right-0.5 -bottom-0.5 size-3 rounded-full bg-emerald-500 ring-2 ring-base-100" />
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-medium">
                      <.player_link player={friend}>{friend.name}</.player_link>
                    </p>
                    <p class="truncate text-xs text-base-content/60">
                      {activity_text(friend.activity)}
                    </p>
                  </div>
                </li>
              </ul>
          <% end %>
        </section>
      </div>
    </div>
  </div>
</Layouts.app>
