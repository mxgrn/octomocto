<Layouts.app
  notices={@notices}
  flash={@flash}
  games_played={@games_played}
  online_count={@online_count}
  banners={@banners}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
  guest_unread_notifications={@guest_unread_notifications}
  languages={@languages}
>
  <%!--
    The same layout as the Memory page. One column on a small screen: the
    title, the tab and the results. Two columns on a large screen: the
    results go to the right. Three columns on an extra large screen: the
    tab in the center is wider than the other columns, and the left column
    is empty, so that the tabs stay in place.
    The last row takes the free height, so that the tall results column does
    not make gaps between the rows on the left.
    In free play on an extra large screen, the columns fill the height of the
    window below the 4rem header. Only the settings scroll, and the results
    hide the rows that do not fit.
  --%>
  <div
    id="trains-index"
    class={[
      "relative start-1/2 grid w-[min(96vw,51rem)] -translate-x-1/2 rtl:translate-x-1/2 gap-6 pt-4 pb-12 lg:w-[calc(100vw-4rem)] lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-12 lg:pt-6 lg:pb-16 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_minmax(0,1fr)]",
      @live_action == :index &&
        "xl:h-[calc(100dvh-4rem)] xl:grid-rows-[auto_minmax(0,1fr)] xl:pb-6"
    ]}
  >
    <div class="mx-auto w-full max-w-md space-y-2 text-center lg:col-start-1 lg:row-start-1 xl:col-start-2 lg:max-w-none">
      <div class="flex items-center justify-center gap-3">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-octo-indigo/10 shadow-inner">
          <OctomoctoWeb.GameIcons.game_icon game="trains" class="size-9" />
        </div>
        <h1 class="text-3xl font-semibold tracking-tight">
          {dgettext("trains", "Right on Track")}
        </h1>
      </div>
      <p class="text-base-content/70">
        <%= if @match do %>
          {dgettext("trains", "Choose the settings of the next game.")}
        <% else %>
          {dgettext(
            "trains",
            "A train switching game: click the switches to send each train to the house with its colors."
          )}
        <% end %>
      </p>
      <.how_to_play />
      <%!-- A match plays on with the same players, so it needs no other games --%>
      <div :if={!@match} class="pt-2">
        <.mode_tabs
          tab={if(@live_action == :index, do: :free, else: @live_action)}
          free_path={settings_path(@locale, @settings, %{})}
          campaign_path={Locale.path(@locale, ~p"/trains/campaign")}
          lobby_path={Locale.path(@locale, ~p"/trains/lobby")}
          free_label={dgettext("trains", "Free play")}
          campaign_label={dgettext("trains", "Campaign")}
          lobby_label={dgettext("trains", "Lobby")}
          lobby_count={Enum.count(@lobby_games, &(&1.status == :open))}
        />
      </div>
    </div>

    <%= if @live_action == :campaign do %>
      <div
        id="campaign"
        class="relative mx-auto flex w-full max-w-md flex-col gap-4 lg:col-start-1 lg:row-start-2 xl:col-start-2 lg:max-w-none"
      >
        <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-base-content/10 dark:bg-base-100">
          <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <.setting_header label={dgettext("trains", "Levels")} icon="hero-map" />
            <span
              :if={@current_scope}
              id="campaign-highest"
              class="flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3 py-1 text-sm"
            >
              <.icon name="hero-trophy" class="size-3.5 text-amber-500" />
              <span class="text-base-content/60">{dgettext("trains", "Highest level")}</span>
              <span class="font-semibold tabular-nums">{@campaign.highest}</span>
            </span>
          </div>
          <p id="campaign-rule" class="text-sm text-base-content/60">
            {dgettext("trains", "Get 90% of the trains home to unlock the next level.")}
          </p>
          <.campaign_map
            levels={@campaign.levels}
            selected={@campaign.selected.level}
            path={&campaign_path(@locale, &1)}
            label={&dgettext("trains", "Level %{level}", level: &1)}
          >
            <:caption :let={level}>
              {switches(level.switch_count)}
              <span class="block text-[10px] leading-tight text-base-content/50">
                {pace_name(level.pace)}
              </span>
            </:caption>
          </.campaign_map>
        </div>
        <.level_card
          :if={@current_scope}
          level={@campaign.selected}
          highest={@campaign.highest}
        />
        <.sign_in_overlay
          :if={!@current_scope}
          title={dgettext("trains", "Sign in to enable campaigns")}
          text={dgettext("trains", "Your progress is saved to your account.")}
          button={dgettext("trains", "Sign in")}
        />
      </div>

      <div
        id="campaign-results"
        class="mx-auto grid w-full max-w-md gap-4 lg:col-start-2 lg:row-span-2 lg:row-start-1 xl:col-start-3 lg:max-w-none"
      >
        <.score_list
          id="campaign-leaderboard"
          icon="hero-trophy"
          icon_class="text-amber-500"
          title={dgettext("trains", "Highest levels")}
          empty={@campaign.leaderboard == []}
          empty_text={dgettext("trains", "Nobody has passed a level yet.")}
        >
          <.result_row :for={{row, place} <- Enum.with_index(@campaign.leaderboard, 1)}>
            <span class="w-4 shrink-0 text-end tabular-nums text-base-content/40">{place}</span>
            <span class="min-w-0 flex-1 truncate font-medium"><.player_link player={row.user}>{player_name(
              row.user
            )}</.player_link></span>
            <.result_pill best={@current_scope != nil and row.user_id == @current_scope.user.id}>
              {dgettext("trains", "Level %{level}", level: row.level)}
            </.result_pill>
          </.result_row>
        </.score_list>
      </div>
    <% else %>
      <div
        :if={@live_action == :lobby}
        id="trains-lobby"
        class="mx-auto grid w-full max-w-md gap-4 lg:col-start-1 lg:row-start-2 xl:col-start-2 lg:max-w-none"
      >
        <.lobby_games
          games={@lobby_games}
          watchers={@watchers}
          path={&Locale.path(@locale, ~p"/trains/#{&1.id}")}
          new_game_path={settings_path(@locale, @settings, %{})}
        >
          <:icon :let={_game}>
            <OctomoctoWeb.GameIcons.game_icon game="trains" class="size-9 shrink-0" />
          </:icon>
          <:summary :let={game}>{game_summary(game)}</:summary>
        </.lobby_games>
      </div>

      <%!-- The padding keeps the rings of the boxes and the wide start bar in the scroll box --%>
      <div
        :if={@live_action == :index}
        class="mx-auto flex w-full max-w-md flex-col items-center gap-6 text-center lg:sticky lg:top-8 lg:col-start-1 lg:row-start-2 xl:static xl:col-start-2 xl:-mx-2 xl:w-[calc(100%+1rem)] lg:max-w-none xl:self-stretch xl:overflow-y-auto xl:px-2 xl:pt-1"
      >
        <div id="trains-settings" class="flex w-full flex-col gap-4">
          <.match_score
            :if={@match}
            players={@match.state.players}
            wins={false}
            me={@match.player_id}
            back={Locale.path(@locale, ~p"/trains/#{@match.id}")}
          />
          <.setting
            :if={!@match}
            id="setting-players"
            label={dgettext("trains", "Players")}
            icon="hero-users"
            hint={
              if(@settings.players > 1,
                do: dgettext("trains", "Play together. Each player owns some of the switches."),
                else: dgettext("trains", "You own all the switches.")
              )
            }
          >
            <.option
              :for={n <- 1..4}
              id={"players-#{n}"}
              selected={@settings.players == n}
              patch={settings_path(@locale, @settings, %{players: n})}
            >
              {n}
            </.option>
          </.setting>
          <.setting
            id="setting-switches"
            label={dgettext("trains", "Switches")}
            icon="hero-arrows-right-left"
            hint={switches_hint(@settings.switch_count, @settings.players)}
          >
            <.option
              :for={n <- @switch_counts}
              id={"switches-#{n}"}
              selected={@settings.switch_count == n}
              patch={settings_path(@locale, @settings, %{switch_count: n})}
            >
              {n}
            </.option>
          </.setting>
          <.setting
            id="setting-trains-per-house"
            label={dgettext("trains", "Trains per house")}
            icon="hero-home"
            hint={trains_hint(@settings)}
          >
            <.option
              :for={n <- 1..7}
              id={"trains-#{n}"}
              selected={@settings.trains_per_house == n}
              patch={settings_path(@locale, @settings, %{trains_per_house: n})}
            >
              {n}
            </.option>
          </.setting>
          <.setting
            id="setting-pace"
            label={dgettext("trains", "Pace")}
            icon="hero-bolt"
            hint={pace_hint(@settings.pace)}
          >
            <.option
              :for={pace <- Octomocto.Trains.paces()}
              id={"pace-#{pace}"}
              selected={@settings.pace == pace}
              patch={settings_path(@locale, @settings, %{pace: pace})}
            >
              {pace_name(pace)}
            </.option>
          </.setting>
          <.setting
            :if={!@match}
            id="setting-visibility"
            label={dgettext("trains", "Visibility")}
            icon="hero-eye"
            hint={visibility_hint(@settings)}
          >
            <.option
              :for={
                {value, public, label} <- [
                  {"public", true, dgettext("trains", "Public")},
                  {"private", false, dgettext("trains", "Private")}
                ]
              }
              id={"visibility-#{value}"}
              selected={@settings.public == public}
              patch={settings_path(@locale, @settings, %{public: public})}
            >
              {label}
            </.option>
          </.setting>
        </div>

        <.start_bar multiplayer={@settings.players > 1} match={@match != nil} />
      </div>

      <div
        id="trains-leaderboard"
        class={[
          "mx-auto grid w-full max-w-md gap-4 lg:col-start-2 lg:row-span-2 lg:row-start-1 xl:col-start-3 lg:max-w-none",
          @live_action == :index &&
            "xl:-mt-1 xl:content-start xl:self-stretch xl:overflow-y-clip xl:pt-1"
        ]}
      >
        <.score_list
          id="your-results"
          icon="hero-user"
          icon_class="text-octo-indigo"
          title={dgettext("trains", "Your results")}
          empty={@user_results != nil and @user_results.latest == []}
          empty_text={dgettext("trains", "No games yet.")}
          sign_in={!@user_results && Locale.path(@locale, ~p"/signin")}
          preview_key={@results_preview && @results_preview.key}
        >
          <:aside :if={@user_results && @user_results.best}>
            <span
              id="your-best"
              class="flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3 py-1 text-sm"
            >
              <.icon name="hero-trophy" class="size-3.5 text-amber-500" />
              <span class="text-base-content/60">{dgettext("trains", "Best")}</span>
              <span class="font-semibold tabular-nums">
                {format_score(@user_results.best.score, trains(@settings))}
              </span>
            </span>
          </:aside>
          <:chart>
            <.sparkline
              id="your-trend"
              points={(@user_results || @results_preview).trend}
              best={(@user_results || @results_preview).best}
            />
          </:chart>
          <%= if @user_results do %>
            <.result_row :for={%{result: result, players: players} <- @user_results.latest}>
              <span :if={@settings.players == 1} class="flex-1 font-medium">
                {Locale.short_date(result.inserted_at)}
              </span>
              <span :if={@settings.players > 1} class="min-w-0 flex-1 font-medium">
                <.player_list players={players} scores={false} />
              </span>
              <.result_pill best={
                @user_results.best != nil and result.id == @user_results.best.id
              }>
                {format_score(result.score, trains(@settings))}
              </.result_pill>
            </.result_row>
          <% else %>
            <.preview_rows
              rows={@results_preview.latest}
              best={@results_preview.best}
              format={&format_score(&1, trains(@settings))}
            />
          <% end %>
        </.score_list>
        <.score_list
          id="best-results"
          icon="hero-trophy"
          icon_class="text-amber-500"
          title={dgettext("trains", "Best results")}
          empty={@best_results == []}
          empty_text={OctomoctoWeb.BestResults.empty_text(@best_following)}
        >
          <:aside :if={@user_results}>
            <OctomoctoWeb.BestResults.filter following={@best_following} />
          </:aside>
          <:aside :if={!@user_results}>
            <span class="text-sm text-base-content/60">
              <.link
                id="best-results-sign-in"
                href={Locale.path(@locale, ~p"/signin")}
                class="font-medium text-octo-indigo transition hover:text-octo-indigo/80 hover:underline"
              >
                {dgettext("trains", "Sign in")}
              </.link>
              {dgettext("trains", "to get listed")}
            </span>
          </:aside>
          <.result_row :for={{result, place} <- Enum.with_index(@best_results, 1)}>
            <span class="w-4 shrink-0 text-end tabular-nums text-base-content/40">{place}</span>
            <span class="min-w-0 flex-1 truncate font-medium"><.player_link player={result.user}>{player_name(
              result.user
            )}</.player_link></span>
            <.result_pill>
              {format_score(result.score, trains(@settings))}
            </.result_pill>
          </.result_row>
        </.score_list>
      </div>
    <% end %>
  </div>

  <.rules rules={@rules} />
</Layouts.app>
