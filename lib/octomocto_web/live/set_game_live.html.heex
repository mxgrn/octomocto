<Layouts.app
  notices={@notices}
  flash={@flash}
  games_played={@games_played}
  banners={@banners}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
  guest_unread_notifications={@guest_unread_notifications}
  languages={@languages}
>
  <%!--
    Wider than the app container, so that the columns have room. One column
    on a small screen: the title with the tabs, the tab and the results. Two
    columns on a large screen: the results go to the right. Three columns on
    an extra large screen: the tab in the center is wider than the other
    columns, and the left column is empty, so that the tabs stay in place. The
    columns use the full width of the screen, with the side padding of the
    header.
    The last row takes the free height, so that the tall results column does
    not make gaps between the rows on the left.
  --%>
  <div
    id="set-index"
    class="relative start-1/2 grid w-[min(96vw,51rem)] -translate-x-1/2 rtl:translate-x-1/2 gap-6 pt-4 pb-12 lg:w-[calc(100vw-4rem)] lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-12 lg:pt-6 lg:pb-16 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_minmax(0,1fr)] xl:grid-rows-[auto_1fr]"
  >
    <div class="mx-auto w-full max-w-md space-y-2 text-center lg:col-start-1 lg:row-start-1 xl:col-start-2 lg:max-w-none">
      <div class="flex items-center justify-center gap-3">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-octo-indigo/10 shadow-inner">
          <OctomoctoWeb.GameIcons.game_icon game="set" class="size-9" />
        </div>
        <h1 class="text-3xl font-semibold tracking-tight">{dgettext("set", "Set")}</h1>
      </div>
      <p class="text-base-content/70">
        <%= if @match do %>
          {dgettext("set", "Choose the settings of the next game.")}
        <% else %>
          {dgettext(
            "set",
            "The Set card game: find 3 cards where each feature is all the same or all different."
          )}
        <% end %>
      </p>
      <.how_to_play />
      <div :if={!@match} class="pt-2">
        <.mode_tabs
          tab={if(@live_action == :lobby, do: :lobby, else: :free)}
          free_path={settings_path(@locale, @settings, [])}
          free_label={dgettext("set", "New game")}
          lobby_path={Locale.path(@locale, ~p"/set/lobby")}
          lobby_label={dgettext("set", "Lobby")}
          lobby_count={Enum.count(@lobby_games, &(&1.status == :open))}
        />
      </div>
    </div>

    <%!-- A match plays on with the same players, so it needs no other games --%>
    <div
      :if={@live_action == :lobby}
      id="set-lobby"
      class="mx-auto grid w-full max-w-md gap-4 lg:col-start-1 lg:row-start-2 xl:col-start-2 lg:max-w-none"
    >
      <.lobby_games
        games={@lobby_games}
        watchers={@watchers}
        matches={&same_settings?(&1, @settings)}
        path={&Locale.path(@locale, ~p"/set/#{&1.id}")}
        new_game_path={settings_path(@locale, @settings, [])}
      >
        <:icon :let={_game}><.card_icon class="w-9 shrink-0" /></:icon>
        <:summary :let={game}>{game_summary(game)}</:summary>
      </.lobby_games>
    </div>

    <div
      :if={@live_action == :index}
      class="mx-auto flex w-full max-w-md flex-col items-center gap-6 text-center lg:sticky lg:top-8 lg:col-start-1 lg:row-start-2 xl:col-start-2 xl:row-start-2 lg:max-w-none"
    >
      <div id="set-settings" class="flex w-full flex-col gap-4">
        <.match_score
          :if={@match}
          players={@match.state.players}
          ties={@match.state.ties}
          me={@match.player_id}
          back={Locale.path(@locale, ~p"/set/#{@match.id}")}
        />
        <.setting
          :if={!@match}
          id="setting-players"
          label={dgettext("set", "Players")}
          icon="hero-users"
          hint={players_hint(@settings.players)}
        >
          <.option
            :for={n <- 1..4}
            id={"players-#{n}"}
            selected={@settings.players == n}
            patch={settings_path(@locale, @settings, players: n)}
          >
            {n}
          </.option>
        </.setting>
        <.setting
          id="setting-mode"
          label={dgettext("set", "Mode")}
          icon="hero-adjustments-horizontal"
          hint={mode_hint(@settings.mode)}
        >
          <.option
            :for={mode <- Deck.modes()}
            id={"mode-#{mode}"}
            selected={@settings.mode == mode}
            patch={settings_path(@locale, @settings, mode: mode)}
          >
            {mode_name(mode)}
          </.option>
        </.setting>
        <.setting
          :if={!@match}
          id="setting-visibility"
          label={dgettext("set", "Visibility")}
          icon="hero-eye"
          hint={visibility_hint(@settings)}
        >
          <.option
            :for={
              {value, public, label} <- [
                {"public", true, dgettext("set", "Public")},
                {"private", false, dgettext("set", "Private")}
              ]
            }
            id={"visibility-#{value}"}
            selected={@settings.public == public}
            patch={settings_path(@locale, @settings, public: public)}
          >
            {label}
          </.option>
        </.setting>
      </div>

      <.start_bar multiplayer={@settings.players > 1} match={@match != nil} />
    </div>

    <div
      id="set-leaderboard"
      class="mx-auto grid w-full max-w-md gap-4 lg:col-start-2 lg:row-span-2 lg:row-start-1 xl:col-start-3 lg:max-w-none"
    >
      <.score_list
        id="your-results"
        icon="hero-user"
        icon_class="text-octo-indigo"
        title={dgettext("set", "Your results")}
        empty={@user_results != nil and @user_results.latest == []}
        empty_text={dgettext("set", "No games yet.")}
      >
        <:aside :if={@user_results && @user_results.best}>
          <span
            id="your-best"
            class="flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3 py-1 text-sm"
          >
            <.icon name="hero-trophy" class="size-3.5 text-amber-500" />
            <span class="text-base-content/60">{dgettext("set", "Best")}</span>
            <span class="font-semibold tabular-nums">
              {format_time(@user_results.best.elapsed_ms)}
            </span>
          </span>
        </:aside>
        <%= if @user_results do %>
          <.result_row :for={%{result: result, players: players} <- @user_results.latest}>
            <span :if={@settings.players == 1} class="flex-1 font-medium">
              {Locale.short_date(result.inserted_at)}
            </span>
            <span :if={@settings.players > 1} class="min-w-0 flex-1 font-medium">
              <.player_list players={players} scores />
            </span>
            <.result_pill best={@user_results.best != nil and result.id == @user_results.best.id}>
              {format_time(result.elapsed_ms)}
            </.result_pill>
          </.result_row>
        <% else %>
          <li class="py-2 text-center text-base-content/60">
            <.link
              id="your-results-sign-in"
              href={Locale.path(@locale, ~p"/signin")}
              class="font-medium text-octo-indigo transition hover:text-octo-indigo/80 hover:underline"
            >
              {dgettext("set", "Sign in")}
            </.link>
            {dgettext("set", "to start saving your results.")}
          </li>
        <% end %>
      </.score_list>
      <.score_list
        id="best-results"
        icon="hero-trophy"
        icon_class="text-amber-500"
        title={dgettext("set", "Best results")}
        empty={@best_results == []}
        empty_text={OctomoctoWeb.BestResults.empty_text(@best_following)}
      >
        <:aside :if={@user_results}>
          <OctomoctoWeb.BestResults.filter following={@best_following} />
        </:aside>
        <:aside :if={!@user_results}>
          <span class="text-sm text-base-content/60">
            <.link
              id="best-results-sign-in"
              href={Locale.path(@locale, ~p"/signin")}
              class="font-medium text-octo-indigo transition hover:text-octo-indigo/80 hover:underline"
            >
              {dgettext("set", "Sign in")}
            </.link>
            {dgettext("set", "to get listed")}
          </span>
        </:aside>
        <.result_row :for={{result, place} <- Enum.with_index(@best_results, 1)}>
          <span class="w-4 shrink-0 text-end tabular-nums text-base-content/40">{place}</span>
          <span class="min-w-0 flex-1 truncate font-medium"><.player_link player={result.user}>{player_name(
            result.user
          )}</.player_link></span>
          <.result_pill>{format_time(result.elapsed_ms)}</.result_pill>
        </.result_row>
      </.score_list>
    </div>
  </div>

  <.rules rules={@rules} />
</Layouts.app>
