<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  guest_name={@guest_name}
  banner={@banner}
  notifications={@notifications}
  languages={@languages}
>
  <%!--
    Wider than the app container, so that the columns have room. One column
    on a small screen: the title, the tab and the results. Two columns on a
    large screen: the results go to the right. Three columns on an extra
    large screen: the tab in the center is wider than the other columns, and
    the left column is empty, so that the tabs stay in place. The columns
    use the full width of the screen, with the side padding of the header.
    The last row takes the free height, so that the tall results column does
    not make gaps between the rows on the left.
    In free play on an extra large screen, the columns fill the height of the
    window below the 4rem header. Only the settings scroll, and the results
    hide the rows that do not fit.
  --%>
  <div
    id="memory-index"
    class={[
      "relative left-1/2 grid w-[min(96vw,51rem)] -translate-x-1/2 gap-6 pt-4 pb-12 lg:grid-cols-2 lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-12 lg:pt-6 lg:pb-16 xl:w-[calc(100vw-4rem)] xl:grid-cols-[1fr_1.4fr_1fr]",
      @live_action == :index &&
        "xl:h-[calc(100dvh-4rem)] xl:grid-rows-[auto_minmax(0,1fr)] xl:pb-6"
    ]}
  >
    <div class="mx-auto w-full max-w-md space-y-2 text-center lg:col-start-1 lg:row-start-1 xl:col-start-2 xl:max-w-none">
      <div class="flex items-center justify-center gap-3">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-octo-indigo/10 shadow-inner">
          <OctomoctoWeb.GameIcons.game_icon game="memory" class="size-9" />
        </div>
        <h1 class="text-3xl font-semibold tracking-tight">{dgettext("memory", "Memory")}</h1>
      </div>
      <p class="text-base-content/70">
        <%= cond do %>
          <% @match -> %>
            {dgettext("memory", "Choose the settings of the next game.")}
          <% @live_action == :campaign -> %>
            {dgettext("memory", "Get 100% accuracy to unlock the next level.")}
          <% @live_action == :lobby -> %>
            {dgettext("memory", "Join a game, or watch one.")}
          <% true -> %>
            {dgettext("memory", "Choose the settings and start a new game.")}
        <% end %>
      </p>
      <.how_to_play />
      <div :if={!@match} class="pt-2">
        <.mode_tabs
          tab={if(@live_action == :index, do: :free, else: @live_action)}
          free_path={settings_path(@locale, @settings, [])}
          campaign_path={Locale.path(@locale, ~p"/memory/campaign")}
          lobby_path={Locale.path(@locale, ~p"/memory/lobby")}
          free_label={dgettext("memory", "Free play")}
          campaign_label={dgettext("memory", "Campaign")}
          lobby_label={dgettext("memory", "Lobby")}
          lobby_count={Enum.count(@lobby_games, &(&1.status == :open))}
        />
      </div>
    </div>

    <%= if @live_action == :campaign do %>
      <div
        id="campaign"
        class="relative mx-auto flex w-full max-w-md flex-col gap-4 lg:col-start-1 lg:row-start-2 xl:col-start-2 xl:max-w-none"
      >
        <div class="rounded-2xl bg-base-100 p-5 shadow-sm ring-1 ring-base-content/10">
          <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <.setting_header label={dgettext("memory", "Levels")} icon="hero-map" />
            <span
              :if={@current_scope}
              id="campaign-highest"
              class="flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3 py-1 text-sm"
            >
              <.icon name="hero-trophy" class="size-3.5 text-amber-500" />
              <span class="text-base-content/60">{dgettext("memory", "Highest level")}</span>
              <span class="font-semibold tabular-nums">{@campaign.highest}</span>
            </span>
          </div>
          <.campaign_map
            levels={@campaign.levels}
            selected={@campaign.selected.level}
            path={&campaign_path(@locale, &1, @campaign.theme)}
            label={&dgettext("memory", "Level %{level}", level: &1)}
          >
            <:caption :let={level}>
              {dngettext("memory", "%{count} card", "%{count} cards", level.cards)}
            </:caption>
            <:badge :let={level}>
              <.level_badge
                :if={level.set == 3}
                locked={level.status == :locked}
                title={dgettext("memory", "Triplets")}
              >
                3
              </.level_badge>
            </:badge>
          </.campaign_map>
        </div>
        <.level_card
          :if={@current_scope}
          level={@campaign.selected}
          theme={@campaign.theme}
          highest={@campaign.highest}
        />
        <.sign_in_overlay
          :if={!@current_scope}
          title={dgettext("memory", "Sign in to enable campaigns")}
          text={dgettext("memory", "Your progress is saved to your account.")}
          button={dgettext("memory", "Sign in")}
        />
      </div>

      <div
        id="campaign-results"
        class="mx-auto grid w-full max-w-md gap-4 lg:col-start-2 lg:row-span-2 lg:row-start-1 xl:col-start-3 xl:max-w-none"
      >
        <.score_list
          id="campaign-leaderboard"
          icon="hero-trophy"
          icon_class="text-amber-500"
          title={dgettext("memory", "Highest levels")}
          empty={@campaign.leaderboard == []}
          empty_text={dgettext("memory", "Nobody has finished a level yet.")}
        >
          <.result_row :for={{row, place} <- Enum.with_index(@campaign.leaderboard, 1)}>
            <span class="w-4 shrink-0 text-right tabular-nums text-base-content/40">{place}</span>
            <span class="min-w-0 flex-1 truncate font-medium">{player_name(row.user)}</span>
            <.result_pill best={@current_scope != nil and row.user_id == @current_scope.user.id}>
              {dgettext("memory", "Level %{level}", level: row.level)}
            </.result_pill>
          </.result_row>
        </.score_list>
      </div>
    <% else %>
      <div
        :if={@live_action == :lobby}
        id="memory-lobby"
        class="mx-auto grid w-full max-w-md gap-4 lg:col-start-1 lg:row-start-2 xl:col-start-2 xl:max-w-none"
      >
        <.lobby_games
          games={@lobby_games}
          watchers={@watchers}
          path={&Locale.path(@locale, ~p"/memory/#{&1.id}")}
          new_game_path={settings_path(@locale, @settings, [])}
        >
          <:icon :let={game}>
            <img
              src={~p"/images/memory/#{game.settings.theme}/#{Themes.cover(game.settings.theme)}"}
              alt=""
              class="size-9 shrink-0"
            />
          </:icon>
          <:summary :let={game}>{game_summary(game)}</:summary>
        </.lobby_games>
      </div>

      <%!-- The padding keeps the rings of the boxes and the wide start bar in the scroll box --%>
      <div
        :if={@live_action == :index}
        class="mx-auto flex w-full max-w-md flex-col items-center gap-6 text-center lg:sticky lg:top-8 lg:col-start-1 lg:row-start-2 xl:static xl:col-start-2 xl:-mx-2 xl:w-[calc(100%+1rem)] xl:max-w-none xl:self-stretch xl:overflow-y-auto xl:px-2 xl:pt-1"
      >
        <div id="memory-settings" class="flex w-full flex-col gap-4">
          <.match_score
            :if={@match}
            players={@match.state.players}
            ties={@match.state.ties}
            me={@match.player_id}
            back={Locale.path(@locale, ~p"/memory/#{@match.id}")}
          />
          <.setting
            :if={!@match}
            label={dgettext("memory", "Players")}
            icon="hero-users"
            hint={
              if(@settings.players > 1,
                do:
                  dgettext(
                    "memory",
                    "The players take turns. The game starts when all players are in."
                  ),
                else: dgettext("memory", "Clear the board as fast as you can.")
              )
            }
          >
            <.option
              :for={n <- 1..4}
              id={"players-#{n}"}
              selected={@settings.players == n}
              patch={settings_path(@locale, @settings, players: n)}
            >
              {n}
            </.option>
          </.setting>
          <div class="rounded-2xl bg-base-100 p-5 shadow-sm ring-1 ring-base-content/10">
            <%!--
              Random is a switch next to the header, out of the grid, so that
              it does not look like a theme. The game picks the theme when it
              starts, and again for each new field. When the switch is on, the
              themes are hidden. Off, it goes back to the last chosen theme.
            --%>
            <div class="flex items-center justify-between gap-2">
              <.setting_header label={dgettext("memory", "Theme")} icon="hero-swatch" />
              <.link
                id="theme-random"
                patch={
                  settings_path(@locale, @settings,
                    theme: if(@settings.theme == "random", do: @last_theme, else: "random")
                  )
                }
                role="switch"
                aria-checked={to_string(@settings.theme == "random")}
                class="group flex items-center gap-2 text-sm font-medium text-base-content/70 transition hover:text-base-content"
              >
                <img
                  src={~p"/images/memory/random.svg"}
                  alt=""
                  class="size-6 transition duration-300 group-hover:scale-110 group-hover:-rotate-12"
                />
                {dgettext("memory", "Random")}
                <span class={[
                  "relative h-6 w-10 shrink-0 rounded-full transition-colors duration-200",
                  if(@settings.theme == "random",
                    do: "bg-octo-indigo",
                    else: "bg-base-content/20 group-hover:bg-base-content/30"
                  )
                ]}>
                  <span class={[
                    "absolute top-0.5 left-0.5 size-5 rounded-full bg-white shadow-sm transition-transform duration-200 ease-out group-active:scale-90",
                    @settings.theme == "random" && "translate-x-4"
                  ]} />
                </span>
              </.link>
            </div>
            <p
              :if={@settings.theme == "random"}
              id="theme-random-hint"
              class="mt-1.5 text-left text-xs text-base-content/50"
            >
              {dgettext("memory", "A new theme for each game.")}
            </p>
            <div :if={@settings.theme != "random"} class="memory-themes-box">
              <div id="memory-themes" class="memory-themes grid grid-cols-4 gap-3 xl:grid-cols-6">
                <.link
                  :for={theme <- @themes}
                  id={"theme-#{theme.name}"}
                  patch={settings_path(@locale, @settings, theme: theme.name)}
                  aria-current={@settings.theme == theme.name && "true"}
                  class={[
                    "group relative flex flex-col items-center gap-1 rounded-xl p-1.5 transition",
                    if(@settings.theme == theme.name,
                      do: "bg-octo-mist ring-2 ring-octo-indigo dark:bg-octo-indigo-light/10",
                      else:
                        "ring-1 ring-base-content/5 hover:bg-base-200 hover:ring-base-content/15"
                    )
                  ]}
                >
                  <span
                    :if={theme[:new]}
                    id={"theme-#{theme.name}-new"}
                    class="absolute -top-1.5 -right-1.5 z-10 rounded-full bg-octo-indigo px-1.5 py-0.5 text-[10px] font-semibold uppercase leading-none tracking-wide text-white shadow-sm"
                  >
                    New
                  </span>
                  <img
                    src={~p"/images/memory/#{theme.name}/#{Themes.cover(theme.name)}"}
                    alt=""
                    class="aspect-square w-full p-1 transition group-hover:scale-105"
                  />
                  <span class="w-full truncate text-xs text-base-content/70">{theme_title(theme)}</span>
                </.link>
              </div>
            </div>
          </div>
          <.setting
            label={dgettext("memory", "Look for")}
            icon="hero-magnifying-glass"
            hint={
              if(@settings.set == 2,
                do: dgettext("memory", "Find 2 cards with the same image."),
                else: dgettext("memory", "Find 3 cards with the same image.")
              )
            }
          >
            <.option
              :for={
                {value, set, label} <- [
                  {"pairs", 2, dgettext("memory", "Pairs")},
                  {"triplets", 3, dgettext("memory", "Triplets")}
                ]
              }
              id={"set-#{value}"}
              selected={@settings.set == set}
              patch={
                settings_path(@locale, @settings,
                  set: set,
                  bombs: div(@settings.bombs, @settings.set) * set
                )
              }
            >
              {label}
            </.option>
          </.setting>
          <.setting label={dgettext("memory", "Cards")} icon="hero-squares-2x2" wide>
            <.step_button
              id="cards-less"
              icon="hero-minus"
              label={dgettext("memory", "Fewer cards")}
              patch={
                if size = step_size(@sizes, @settings.cards, -1),
                  do: settings_path(@locale, @settings, cards: size)
              }
            />
            <.form for={%{}} id="cards-form" phx-change="cards" class="flex flex-1 items-center">
              <input
                type="range"
                id="cards-slider"
                name="index"
                phx-debounce="100"
                phx-patch-focused
                aria-label={dgettext("memory", "Cards")}
                min="0"
                max={length(@sizes) - 1}
                value={Enum.find_index(@sizes, &(&1 == @settings.cards))}
                class="w-full cursor-pointer accent-octo-indigo outline-none"
              />
            </.form>
            <span
              id="cards-count"
              class="min-w-10 self-center text-center text-sm font-semibold tabular-nums"
            >
              {@settings.cards}
            </span>
            <.step_button
              id="cards-more"
              icon="hero-plus"
              label={dgettext("memory", "More cards")}
              patch={
                if size = step_size(@sizes, @settings.cards, 1),
                  do: settings_path(@locale, @settings, cards: size)
              }
            />
          </.setting>
          <.setting
            label={dgettext("memory", "Bombs")}
            icon="icon-bomb"
            badge="New"
            badge_id="bombs-new"
            hint={
              cond do
                @settings.bombs == 0 ->
                  dgettext("memory", "Add bombs to make the game harder.")

                Game.demining?() ->
                  dgettext(
                    "memory",
                    "Turn a bomb that was seen, and you are out. Turn all bombs in one go to demine the field."
                  )

                true ->
                  dgettext("memory", "Turn a bomb that was seen, and you are out.")
              end
            }
          >
            <.option
              :for={n <- @bomb_counts}
              id={"bombs-#{n}"}
              selected={@settings.bombs == n}
              patch={settings_path(@locale, @settings, bombs: n)}
            >
              {if n == 0, do: dgettext("memory", "None"), else: n}
            </.option>
          </.setting>
          <.setting
            :if={!@match}
            label={dgettext("memory", "Visibility")}
            icon="hero-eye"
            hint={visibility_hint(@settings)}
          >
            <.option
              :for={
                {value, public, label} <- [
                  {"public", true, dgettext("memory", "Public")},
                  {"private", false, dgettext("memory", "Private")}
                ]
              }
              id={"visibility-#{value}"}
              selected={@settings.public == public}
              patch={settings_path(@locale, @settings, public: public)}
            >
              {label}
            </.option>
          </.setting>
        </div>

        <.start_bar multiplayer={@settings.players > 1} match={@match != nil} />
      </div>

      <div
        id="memory-leaderboard"
        class={[
          "mx-auto grid w-full max-w-md gap-4 lg:col-start-2 lg:row-span-2 lg:row-start-1 xl:col-start-3 xl:max-w-none",
          @live_action == :index &&
            "xl:-mt-1 xl:content-start xl:self-stretch xl:overflow-y-clip xl:pt-1"
        ]}
      >
        <.score_list
          id="your-results"
          icon="hero-user"
          icon_class="text-octo-indigo"
          title={dgettext("memory", "Your results")}
          empty={@user_results != nil and @user_results.latest == []}
          empty_text={dgettext("memory", "No games yet.")}
        >
          <:aside :if={@user_results && @user_results.best}>
            <span
              id="your-best"
              class="flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3 py-1 text-sm"
            >
              <.icon name="hero-trophy" class="size-3.5 text-amber-500" />
              <span class="text-base-content/60">{dgettext("memory", "Best")}</span>
              <span class="font-semibold tabular-nums">
                {format_time(@user_results.best.elapsed_ms)}
              </span>
            </span>
          </:aside>
          <%= if @user_results do %>
            <.result_row :for={%{result: result, players: players} <- @user_results.latest}>
              <.result_theme theme={result.theme} />
              <span :if={@settings.players == 1} class="flex-1 font-medium">
                {Locale.short_date(result.inserted_at)}
              </span>
              <span :if={@settings.players > 1} class="min-w-0 flex-1 truncate font-medium">
                <.player_list players={players} scores accuracy={&format_accuracy/1} />
              </span>
              <span
                :if={@settings.players == 1}
                class="w-12 text-right tabular-nums text-base-content/60"
                title={dgettext("memory", "Accuracy")}
              >
                {format_accuracy(result)}
              </span>
              <.result_pill best={
                @user_results.best != nil and result.id == @user_results.best.id
              }>
                {format_time(result.elapsed_ms)}
              </.result_pill>
            </.result_row>
          <% else %>
            <li class="py-2 text-center text-base-content/60">
              <.link
                id="your-results-sign-in"
                href={~p"/signin"}
                class="font-medium text-octo-indigo transition hover:text-octo-indigo/80 hover:underline"
              >
                {dgettext("memory", "Sign in")}
              </.link>
              {dgettext("memory", "to start saving your results.")}
            </li>
          <% end %>
        </.score_list>
        <.score_list
          id="best-results"
          icon="hero-trophy"
          icon_class="text-amber-500"
          title={dgettext("memory", "Best results")}
          empty={@best_results == []}
        >
          <:aside :if={!@user_results}>
            <span class="text-sm text-base-content/60">
              <.link
                id="best-results-sign-in"
                href={~p"/signin"}
                class="font-medium text-octo-indigo transition hover:text-octo-indigo/80 hover:underline"
              >
                {dgettext("memory", "Sign in")}
              </.link>
              {dgettext("memory", "to get listed")}
            </span>
          </:aside>
          <.result_row :for={{result, place} <- Enum.with_index(@best_results, 1)}>
            <span class="w-4 shrink-0 text-right tabular-nums text-base-content/40">{place}</span>
            <span class="min-w-0 flex-1 truncate font-medium">{player_name(result.user)}</span>
            <span
              class="w-12 text-right tabular-nums text-base-content/60"
              title={dgettext("memory", "Accuracy")}
            >
              {format_accuracy(result)}
            </span>
            <.result_pill>{format_time(result.elapsed_ms)}</.result_pill>
          </.result_row>
        </.score_list>
      </div>
    <% end %>
  </div>

  <.rules rules={@rules} />
</Layouts.app>
