<Layouts.app
  notices={@notices}
  flash={@flash}
  games_played={@games_played}
  online_count={@online_count}
  banners={@banners}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
  guest_unread_notifications={@guest_unread_notifications}
  languages={@languages}
>
  <%!-- The same columns as on the Memory page --%>
  <div
    id="ink-trail-index"
    class="relative start-1/2 grid w-[min(96vw,51rem)] -translate-x-1/2 rtl:translate-x-1/2 gap-6 pt-4 pb-12 lg:w-[calc(100vw-4rem)] lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-12 lg:pt-6 lg:pb-16 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_minmax(0,1fr)] xl:grid-rows-[auto_1fr]"
  >
    <div class="mx-auto w-full max-w-md lg:max-w-none space-y-2 text-center lg:col-start-1 lg:row-start-1 xl:col-start-2">
      <div class="flex items-center justify-center gap-3">
        <div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-octo-indigo/10 shadow-inner">
          <OctomoctoWeb.GameIcons.game_icon game="ink-trail" class="size-9" />
        </div>
        <h1 class="text-3xl font-semibold tracking-tight">
          {dgettext("ink-trail", "Ink Trail")}
        </h1>
      </div>
      <p class="text-base-content/70">
        {dgettext(
          "ink-trail",
          "Follow the leader octopus from cave to cave, some jets behind it. The better you follow, the further behind you jet (yes, that’s the reward)."
        )}
      </p>
      <.how_to_play />
    </div>

    <div class="mx-auto flex w-full max-w-md lg:max-w-none flex-col items-center gap-6 text-center lg:sticky lg:top-8 lg:col-start-1 lg:row-start-2 xl:col-start-2 xl:row-start-2">
      <div id="ink-trail-settings" class="flex w-full flex-col gap-4">
        <div
          id="ink-trail-start"
          class="flex w-full items-center gap-5 rounded-2xl bg-white p-5 shadow-sm ring-1 ring-base-content/10 dark:bg-base-100"
        >
          <div class="flex size-24 shrink-0 items-center justify-center rounded-2xl bg-octo-indigo/10">
            <OctomoctoWeb.GameIcons.game_icon game="ink-trail" class="size-16" />
          </div>
          <div class="min-w-0 flex-1 space-y-1">
            <.setting_header
              label={dgettext("ink-trail", "Start distance")}
              icon="hero-arrows-right-left"
            />
            <p class="text-start">
              <span id="ink-trail-start-distance" class="text-2xl font-semibold tabular-nums">
                {@start_distance}
              </span>
              <span class="text-base-content/60">
                {dngettext("ink-trail", "jet behind", "jets behind", @start_distance)}
              </span>
            </p>
            <p class="text-start text-xs text-base-content/50">
              {dgettext("ink-trail", "Each 5 correct clicks in a row add a jet.")}
            </p>
          </div>
        </div>

        <.setting
          id="setting-visibility"
          label={dgettext("ink-trail", "Visibility")}
          icon="hero-eye"
          hint={visibility_hint(@settings)}
        >
          <.option
            :for={
              {value, public, label} <- [
                {"public", true, dgettext("ink-trail", "Public")},
                {"private", false, dgettext("ink-trail", "Private")}
              ]
            }
            id={"visibility-#{value}"}
            selected={@settings.public == public}
            patch={settings_path(@locale, @settings, public: public)}
          >
            {label}
          </.option>
        </.setting>
      </div>

      <.start_bar multiplayer={false} />
    </div>

    <div
      id="ink-trail-leaderboard"
      class="mx-auto grid w-full max-w-md lg:max-w-none gap-4 lg:col-start-2 lg:row-span-2 lg:row-start-1 xl:col-start-3"
    >
      <.score_list
        id="your-results"
        icon="hero-user"
        icon_class="text-octo-indigo"
        title={dgettext("ink-trail", "Your results")}
        empty={@user_results != nil and @user_results.latest == []}
        empty_text={dgettext("ink-trail", "No games yet.")}
        sign_in={!@user_results && Locale.path(@locale, ~p"/signin")}
        preview_key={@results_preview && @results_preview.key}
      >
        <:aside :if={@user_results && @user_results.best}>
          <span
            id="your-best"
            class="flex items-center gap-1.5 rounded-full bg-amber-500/10 px-3 py-1 text-sm"
          >
            <.icon name="hero-trophy" class="size-3.5 text-amber-500" />
            <span class="text-base-content/60">{dgettext("ink-trail", "Best")}</span>
            <span class="font-semibold tabular-nums">{@user_results.best.score}</span>
          </span>
        </:aside>
        <:chart>
          <.sparkline
            id="your-trend"
            points={(@user_results || @results_preview).trend}
            best={(@user_results || @results_preview).best}
          />
        </:chart>
        <%= if @user_results do %>
          <.result_row :for={result <- @user_results.latest}>
            <span class="flex-1 font-medium">
              {Locale.short_date(result.inserted_at)}
            </span>
            <span
              class="text-xs text-base-content/50 tabular-nums"
              title={dgettext("ink-trail", "Best distance")}
            >
              {dgettext("ink-trail", "%{distance} back", distance: result.best_distance)}
            </span>
            <span
              class="flex items-center gap-0.5 text-xs text-base-content/50 tabular-nums"
              title={dgettext("ink-trail", "Mistakes")}
            >
              <.icon name="hero-x-mark" class="size-3" />{result.wrong}
            </span>
            <.result_pill best={@user_results.best != nil and result.id == @user_results.best.id}>
              {result.score}
            </.result_pill>
          </.result_row>
        <% else %>
          <.preview_rows
            rows={@results_preview.latest}
            best={@results_preview.best}
            format={&Integer.to_string/1}
          />
        <% end %>
      </.score_list>
      <.score_list
        id="best-results"
        icon="hero-trophy"
        icon_class="text-amber-500"
        title={dgettext("ink-trail", "Best results")}
        empty={@best_results == []}
        empty_text={OctomoctoWeb.BestResults.empty_text(@best_following)}
      >
        <:aside :if={@user_results}>
          <OctomoctoWeb.BestResults.filter following={@best_following} />
        </:aside>
        <:aside :if={!@user_results}>
          <span class="text-sm text-base-content/60">
            <.link
              id="best-results-sign-in"
              href={Locale.path(@locale, ~p"/signin")}
              class="font-medium text-octo-indigo transition hover:text-octo-indigo/80 hover:underline"
            >
              {dgettext("ink-trail", "Sign in")}
            </.link>
            {dgettext("ink-trail", "to get listed")}
          </span>
        </:aside>
        <.result_row :for={{result, place} <- Enum.with_index(@best_results, 1)}>
          <span class="w-4 shrink-0 text-end tabular-nums text-base-content/40">{place}</span>
          <span class="min-w-0 flex-1 truncate font-medium"><.player_link player={result.user}>{player_name(
            result.user
          )}</.player_link></span>
          <span
            class="text-xs text-base-content/50 tabular-nums"
            title={dgettext("ink-trail", "Best distance")}
          >
            {dgettext("ink-trail", "%{distance} back", distance: result.best_distance)}
          </span>
          <span
            class="flex items-center gap-0.5 text-xs text-base-content/50 tabular-nums"
            title={dgettext("ink-trail", "Mistakes")}
          >
            <.icon name="hero-x-mark" class="size-3" />{result.wrong}
          </span>
          <.result_pill>{result.score}</.result_pill>
        </.result_row>
      </.score_list>
      <.memory_games id="more-games" game="ink-trail" locale={@locale} class="xl:hidden" />
    </div>

    <%!-- The left column is empty on an extra large screen. On a smaller screen, the games are under the results. --%>
    <.memory_games
      id="more-games-side"
      game="ink-trail"
      locale={@locale}
      class="hidden xl:col-start-1 xl:row-span-2 xl:row-start-1 xl:block xl:self-start"
    />
  </div>

  <.rules rules={@rules} />
</Layouts.app>
