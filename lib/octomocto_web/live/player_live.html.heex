<Layouts.app
  notices={@notices}
  flash={@flash}
  games_played={@games_played}
  banners={@banners}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
>
  <% most = @games |> Enum.map(& &1.count) |> Enum.max(fn -> 0 end) %>

  <div id="player" class="mx-auto flex w-full max-w-2xl flex-col gap-6 pt-2 pb-4">
    <div class="flex items-center gap-4">
      <%!-- As the avatars in Friends online on the front page --%>
      <img
        :if={@profile.avatar_url}
        id="player-avatar"
        src={@profile.avatar_url}
        alt=""
        class="size-14 shrink-0 rounded-full object-cover"
      />
      <span
        :if={!@profile.avatar_url}
        id="player-initial"
        class="flex size-14 shrink-0 items-center justify-center rounded-full bg-octo-indigo/10 text-2xl font-semibold text-octo-indigo dark:bg-octo-indigo-light/15 dark:text-octo-indigo-light"
      >
        {@profile.name |> String.first() |> String.upcase()}
      </span>
      <div class="min-w-0">
        <h1
          id="player-name"
          class="truncate text-2xl font-semibold tracking-tight text-octo-navy dark:text-base-content"
        >
          {@profile.name}
        </h1>
        <p :if={@profile.guest} id="player-guest" class="text-sm text-base-content/60">Guest</p>
        <p :if={!@profile.guest} id="player-follows" class="mt-0.5 flex gap-4 text-sm">
          <.link
            :for={
              {list, label, path} <- [
                {:followers, "Followers", ~p"/players/#{@public_id}/followers"},
                {:following, "Following", ~p"/players/#{@public_id}/following"}
              ]
            }
            id={"player-#{list}-link"}
            navigate={path}
            class="group whitespace-nowrap text-base-content/60 transition-colors hover:text-octo-indigo dark:hover:text-octo-indigo-light"
          >
            <span class="font-semibold text-octo-navy tabular-nums transition-colors group-hover:text-octo-indigo dark:text-base-content dark:group-hover:text-octo-indigo-light">
              {Map.fetch!(@profile, list)}
            </span>
            {label}
          </.link>
        </p>
      </div>
      <div :if={@follow} class="ml-auto shrink-0">
        <button
          :if={!@follow.following}
          id="follow-button"
          type="button"
          phx-click="follow"
          class="flex items-center gap-1.5 rounded-full bg-octo-indigo px-4 py-1.5 text-sm font-medium text-white shadow-sm transition-colors hover:bg-octo-indigo/85 active:scale-95"
        >
          <.icon name="hero-user-plus" class="size-4" />
          {if @follow.followed_by, do: "Follow back", else: "Follow"}
        </button>
        <%!-- Shows "Unfollow" on hover --%>
        <button
          :if={@follow.following}
          id="unfollow-button"
          type="button"
          phx-click="unfollow"
          data-confirm={
            @follow.friends && "You are friends. If you unfollow, you are not friends."
          }
          class="group flex items-center gap-1.5 rounded-full px-4 py-1.5 text-sm font-medium text-base-content/70 ring-1 ring-base-content/15 transition-colors hover:bg-red-500/5 hover:text-red-600 hover:ring-red-500/30 active:scale-95 dark:hover:text-red-400"
        >
          <span class="flex items-center gap-1.5 group-hover:hidden">
            <%= if @follow.friends do %>
              <.icon name="hero-users" class="size-4" /> Friends
            <% else %>
              <.icon name="hero-check" class="size-4" /> Following
            <% end %>
          </span>
          <span class="hidden items-center gap-1.5 group-hover:flex">
            <.icon name="hero-user-minus" class="size-4" /> Unfollow
          </span>
        </button>
      </div>
    </div>

    <section
      id="player-summary"
      class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-base-content/10 dark:bg-base-100 sm:p-6"
    >
      <dl class="grid grid-cols-2 gap-6 sm:grid-cols-3">
        <div id="player-joined">
          <dt class="text-sm text-base-content/60">Joined</dt>
          <dd class="mt-0.5 text-lg font-semibold text-octo-navy dark:text-base-content">
            <time
              datetime={DateTime.to_iso8601(@profile.joined_at)}
              title={Calendar.strftime(@profile.joined_at, "%b %-d, %Y")}
            >
              {ago(@profile.joined_at)}
            </time>
          </dd>
        </div>
        <div id="player-games">
          <dt class="text-sm text-base-content/60">Games played</dt>
          <dd class="mt-0.5 text-lg font-semibold text-octo-navy tabular-nums dark:text-base-content">
            {@total}
          </dd>
        </div>
        <div :if={@profile.online || @profile.last_played_at} id="player-last-active">
          <dt class="text-sm text-base-content/60">Last active</dt>
          <dd class="mt-0.5 text-lg font-semibold text-octo-navy dark:text-base-content">
            <span
              :if={@profile.online}
              id="player-online"
              class="flex items-center gap-2 whitespace-nowrap"
            >
              <span class="size-2 shrink-0 rounded-full bg-emerald-500"></span> Online now
            </span>
            <time
              :if={!@profile.online}
              datetime={DateTime.to_iso8601(@profile.last_played_at)}
              title={Calendar.strftime(@profile.last_played_at, "%b %-d, %Y %H:%M UTC")}
            >
              {ago(@profile.last_played_at)}
            </time>
          </dd>
        </div>
      </dl>
    </section>

    <section
      id="player-by-game"
      class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-base-content/10 dark:bg-base-100 sm:p-6"
    >
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 class="font-semibold text-octo-navy dark:text-base-content">By game</h2>
        <span :if={@games != []} class="text-xs text-base-content/50">Last {@days} days</span>
      </div>
      <p :if={@games == []} id="player-no-recent-games" class="text-sm text-base-content/60">
        {if @total == 0, do: "No games yet.", else: "No games in the last #{@days} days."}
      </p>
      <ul :if={@games != []} class="flex flex-col gap-3">
        <li :for={game <- @games} id={"player-game-#{game.id}"} class="flex items-center gap-3">
          <div class={[
            "flex size-9 shrink-0 items-center justify-center rounded-xl",
            game.icon_class
          ]}>
            <GameIcons.game_icon game={game.id} class="size-7" />
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-4 text-sm">
              <.link
                navigate={game.path}
                class="font-medium text-octo-navy transition hover:text-octo-indigo dark:text-base-content dark:hover:text-octo-indigo-light"
              >
                {game.name}
              </.link>
              <span class="flex items-center gap-3">
                <.sparkline
                  id={"player-activity-#{game.id}"}
                  days={game.days}
                  most={@most_in_day}
                />
                <span class="min-w-8 text-right font-semibold text-octo-navy tabular-nums dark:text-base-content">
                  {game.count}
                </span>
              </span>
            </div>
            <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-base-content/5">
              <div
                class="h-full rounded-full bg-octo-indigo transition-[width] duration-500 dark:bg-octo-indigo-light"
                style={"width: #{game.count / most * 100}%"}
              >
              </div>
            </div>
          </div>
        </li>
      </ul>
    </section>
  </div>
</Layouts.app>
