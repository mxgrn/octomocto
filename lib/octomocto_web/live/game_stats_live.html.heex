<Layouts.app
  notices={@notices}
  flash={@flash}
  games_played={@games_played}
  banners={@banners}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
  guest_unread_notifications={@guest_unread_notifications}
>
  <% most = @players |> Enum.map(& &1.count) |> Enum.max(fn -> 0 end) %>

  <div id="game-stats" class="mx-auto flex w-full max-w-2xl flex-col gap-6 pt-2 pb-4">
    <div>
      <div class="flex items-center justify-between gap-4">
        <.link
          navigate={StatsLive.stats_path(~p"/stats", @today?, @days)}
          id="game-stats-back"
          class="inline-flex items-center gap-1 text-sm text-base-content/60 transition hover:text-octo-indigo dark:hover:text-octo-indigo-light"
        >
          <.icon name="hero-arrow-left" class="size-4" /> Stats
        </.link>
        <div class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2">
          <StatsLive.days_tabs days={@days} today?={@today?} path={~p"/stats/#{@game.id}"} />
          <StatsLive.today_toggle on={@today?} days={@days} path={~p"/stats/#{@game.id}"} />
        </div>
      </div>
      <div class="mt-3 flex items-center gap-3">
        <div class={[
          "flex size-11 shrink-0 items-center justify-center rounded-xl",
          @game.icon_class
        ]}>
          <GameIcons.game_icon game={@game.id} class="size-8" />
        </div>
        <div class="min-w-0 flex-1">
          <h1 class="text-2xl font-semibold tracking-tight text-octo-navy dark:text-base-content">
            {@game.name}
          </h1>
          <p class="text-sm text-base-content/60">
            The players with the most games in {StatsLive.period_text(@today?, @days)}.
          </p>
        </div>
        <.link
          navigate={@game.path}
          id="game-stats-play"
          class="shrink-0 rounded-full bg-octo-indigo px-4 py-1.5 text-sm font-medium text-white transition hover:bg-octo-indigo/90 active:scale-95"
        >
          Play
        </.link>
      </div>
    </div>

    <section
      id="top-players"
      class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-base-content/10 dark:bg-base-100 sm:p-6"
    >
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 class="font-semibold text-octo-navy dark:text-base-content">Top players</h2>
        <span :if={@players != []} class="text-xs text-base-content/50">{StatsLive.period_label(
          @today?,
          @days
        )}</span>
      </div>
      <p :if={@players == []} id="top-players-empty" class="text-sm text-base-content/60">
        No games yet.
      </p>
      <ol :if={@players != []} class="flex flex-col gap-3">
        <li
          :for={{player, place} <- Enum.with_index(@players, 1)}
          id={"top-player-#{place}"}
          class="flex items-center gap-3 text-sm"
        >
          <span class={[
            "flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold tabular-nums",
            if(place <= 3,
              do:
                "bg-octo-indigo/10 text-octo-indigo dark:bg-octo-indigo-light/15 dark:text-octo-indigo-light",
              else: "text-base-content/50"
            )
          ]}>
            {place}
          </span>
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-4">
              <span class="min-w-0 truncate font-medium text-octo-navy dark:text-base-content">
                <.player_link player={player.user || player.guest}>{name(player)}</.player_link>
                <span :if={!player.user} class="ml-1 text-xs font-normal text-base-content/50">
                  Guest
                </span>
              </span>
              <span class="flex shrink-0 items-center gap-3">
                <PlayerLive.sparkline id={"top-player-activity-#{place}"} days={player.days} />
                <span class="min-w-[4ch] text-right font-semibold text-octo-navy tabular-nums dark:text-base-content">
                  {player.count}
                </span>
              </span>
            </div>
            <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-base-content/5">
              <div
                class="h-full rounded-full bg-octo-indigo dark:bg-octo-indigo-light"
                style={"width: #{if most > 0, do: player.count / most * 100, else: 0}%"}
              >
              </div>
            </div>
          </div>
        </li>
      </ol>
    </section>
  </div>
</Layouts.app>
