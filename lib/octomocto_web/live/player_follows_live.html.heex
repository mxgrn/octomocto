<Layouts.app
  notices={@notices}
  flash={@flash}
  games_played={@games_played}
  banners={@banners}
  current_scope={@current_scope}
  guest_name={@guest_name}
  guest_public_id={@guest_public_id}
>
  <div id="player-follows-page" class="mx-auto flex w-full max-w-2xl flex-col gap-6 pt-2 pb-4">
    <div class="flex flex-col gap-3">
      <.link
        id="player-follows-back"
        navigate={~p"/players/#{@public_id}"}
        class="inline-flex items-center gap-1 self-start text-sm text-base-content/60 transition hover:text-octo-indigo dark:hover:text-octo-indigo-light"
      >
        <.icon name="hero-arrow-left" class="size-4" /> {@name}
      </.link>
      <OctomoctoWeb.SettingsComponents.option_slider
        id="player-follows-tabs"
        class="self-start text-sm font-medium"
      >
        <.link
          :for={
            {list, label, path} <- [
              {:followers, "Followers", ~p"/players/#{@public_id}/followers"},
              {:following, "Following", ~p"/players/#{@public_id}/following"}
            ]
          }
          id={"player-follows-tab-#{list}"}
          patch={path}
          aria-current={list == @list && "page"}
          class={[
            "flex items-center gap-1.5 rounded-full px-4 py-1.5 transition-colors",
            if(list == @list,
              do: "bg-white text-base-content shadow-sm dark:bg-white/12",
              else: "text-base-content/60 hover:text-base-content"
            )
          ]}
        >
          {label}
          <span class="tabular-nums text-base-content/50">{@counts[list]}</span>
        </.link>
      </OctomoctoWeb.SettingsComponents.option_slider>
    </div>

    <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-base-content/10 dark:bg-base-100 sm:p-6">
      <p
        :if={@players == []}
        id="player-follows-empty"
        class="py-2 text-center text-sm text-base-content/50"
      >
        {if @list == :followers, do: "No followers yet.", else: "Follows nobody yet."}
      </p>
      <%!-- The rows as in Friends online on the front page --%>
      <ul :if={@players != []} id="player-follows-list" class="-mx-2 space-y-1">
        <li
          :for={player <- @players}
          id={"player-follow-#{player.id}"}
          class="flex items-center gap-3 rounded-xl px-2 py-2 transition-colors hover:bg-base-200/60"
        >
          <% shared = player.id in @shared_ids %>
          <% activity = @activities[player.id] %>
          <% following = player.id in @viewer_following %>
          <% follows_viewer = player.id in @viewer_followers %>
          <span class="relative shrink-0">
            <img
              :if={player.avatar_url}
              src={player.avatar_url}
              alt=""
              class="size-9 rounded-full object-cover"
            />
            <span
              :if={!player.avatar_url}
              class="flex size-9 items-center justify-center rounded-full bg-octo-indigo/10 font-semibold text-octo-indigo dark:bg-octo-indigo-light/15 dark:text-octo-indigo-light"
            >
              {String.first(player.name || "?") |> String.upcase()}
            </span>
            <%!-- Only for a friend of the viewer --%>
            <span
              :if={shared}
              id={"player-follow-status-#{player.id}"}
              data-online={to_string(activity != nil)}
              class={[
                "absolute -right-0.5 -bottom-0.5 size-3 rounded-full ring-2 ring-base-100 transition-colors",
                if(activity, do: "bg-emerald-500", else: "bg-base-content/25")
              ]}
            />
          </span>
          <div class="min-w-0 flex-1">
            <p class="flex min-w-0 items-center gap-2 text-sm font-medium">
              <span class="truncate">
                <.player_link player={player}>{player.name}</.player_link>
              </span>
              <span
                :if={follows_viewer}
                id={"player-follow-follows-you-#{player.id}"}
                class="shrink-0 rounded-md bg-base-200 px-1.5 py-0.5 text-[11px] font-medium text-base-content/60"
              >
                Follows you
              </span>
            </p>
            <p :if={shared && activity} class="truncate text-xs text-base-content/60">
              {HomeLive.activity_text(activity)}
            </p>
          </div>
          <%!-- Not for a guest who looks, and not on the own row --%>
          <div :if={@viewer_id && @viewer_id != player.id} class="shrink-0">
            <button
              :if={!following}
              id={"player-follow-button-#{player.id}"}
              type="button"
              phx-click="follow"
              phx-value-id={player.id}
              class="flex items-center gap-1.5 rounded-full bg-octo-indigo px-3.5 py-1 text-sm font-medium text-white shadow-sm transition-colors hover:bg-octo-indigo/85 active:scale-95"
            >
              {if follows_viewer, do: "Follow back", else: "Follow"}
            </button>
            <%!-- Shows "Unfollow" on hover --%>
            <button
              :if={following}
              id={"player-unfollow-button-#{player.id}"}
              type="button"
              phx-click="unfollow"
              phx-value-id={player.id}
              data-confirm={
                if follows_viewer,
                  do:
                    "Unfollow #{player.name}? You are friends. If you unfollow, you are not friends.",
                  else: "Unfollow #{player.name}?"
              }
              class="group min-w-24 rounded-full px-3.5 py-1 text-sm font-medium text-base-content/70 ring-1 ring-base-content/15 transition-colors hover:bg-red-500/5 hover:text-red-600 hover:ring-red-500/30 active:scale-95 dark:hover:text-red-400"
            >
              <span class="group-hover:hidden">Following</span>
              <span class="hidden group-hover:inline">Unfollow</span>
            </button>
          </div>
        </li>
      </ul>
    </section>
  </div>
</Layouts.app>
