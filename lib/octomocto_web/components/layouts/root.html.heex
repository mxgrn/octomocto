<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Octomocto" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="48x48" />
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link rel="manifest" href={~p"/site.webmanifest"} />
    <meta name="theme-color" content="#EEF0FA" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/elm.js"}>
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      // The theme mode is "system", "light" or "dark". "system" follows the OS setting.
      (() => {
        const media = matchMedia("(prefers-color-scheme: dark)");
        const html = document.documentElement;
        // Kept in memory too, for browsers that block localStorage
        let mode = "system";
        try {
          mode = localStorage.getItem("phx:theme") || "system";
        } catch {}
        const applyTheme = () => {
          const dark = mode === "dark" || (mode === "system" && media.matches);
          html.setAttribute("data-theme", dark ? "dark" : "light");
          html.setAttribute("data-theme-mode", mode);
        };
        applyTheme();
        media.addEventListener("change", applyTheme);
        window.addEventListener("storage", e => {
          if (e.key !== "phx:theme") return;
          mode = e.newValue || "system";
          applyTheme();
        });
        window.addEventListener("phx:set-theme", e => {
          mode = e.target.dataset.phxTheme;
          try {
            localStorage.setItem("phx:theme", mode);
          } catch {}
          applyTheme();
        });
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
