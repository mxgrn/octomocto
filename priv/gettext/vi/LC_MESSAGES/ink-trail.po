#, elixir-autogen, elixir-format
msgid "%{count} mistake"
msgid_plural "%{count} mistakes"
msgstr[0] "%{count} lỗi"

#, elixir-autogen, elixir-format
msgid "%{distance} back"
msgstr "lùi %{distance}"

#, elixir-autogen, elixir-format
msgid "A free sequence memory game like Follow That Frog from Lumosity: follow the path of an octopus from cave to cave, some jets behind it. No sign-up."
msgstr "Trò chơi trí nhớ miễn phí giống Follow That Frog của Lumosity: bơi theo đường đi của chú bạch tuộc từ hang này sang hang khác, chậm hơn nó vài lượt. Không cần đăng ký."

#, elixir-autogen, elixir-format
msgid "A leader octopus jets from cave to cave. Your octopus follows the same path, some jets behind it."
msgstr "Một chú bạch tuộc dẫn đầu phóng từ hang này sang hang khác. Bạch tuộc của bạn đi theo cùng đường đó, chậm hơn vài lượt."

#, elixir-autogen, elixir-format
msgid "Best"
msgstr "Tốt nhất"

#, elixir-autogen, elixir-format
msgid "Best distance"
msgstr "Khoảng cách tốt nhất"

#, elixir-autogen, elixir-format
msgid "Best distance {distance}"
msgstr "Khoảng cách tốt nhất {distance}"

#, elixir-autogen, elixir-format
msgid "Best results"
msgstr "Kết quả tốt nhất"

#, elixir-autogen, elixir-format
msgid "Cave {number}"
msgstr "Hang {number}"

#, elixir-autogen, elixir-format
msgid "Click the cave where your octopus must go next: the cave where the leader was that many jets ago. Then the leader jets again."
msgstr "Bấm vào hang mà bạch tuộc của bạn phải đến tiếp theo: hang mà con dẫn đầu đã ở đúng bấy nhiêu lượt trước. Sau đó con dẫn đầu lại phóng tiếp."

#, elixir-autogen, elixir-format
msgid "Correct in a row"
msgstr "Đúng liên tiếp"

#, elixir-autogen, elixir-format
msgid "Could not join the game: {reason}"
msgstr "Không vào được ván: {reason}"

#, elixir-autogen, elixir-format
msgid "Each 5 correct clicks in a row add a jet."
msgstr "Cứ 5 lần bấm đúng liên tiếp thì lùi thêm một lượt."

#, elixir-autogen, elixir-format
msgid "Each 5 correct clicks in a row put your octopus one jet further behind. A wrong click brings it one jet nearer, but never nearer than 3 jets."
msgstr "Cứ 5 lần bấm đúng liên tiếp, bạch tuộc của bạn lùi xa thêm một lượt. Một lần bấm sai đưa nó lại gần một lượt, nhưng không bao giờ gần hơn 3 lượt."

#, elixir-autogen, elixir-format
msgid "Each correct click gives points times the distance. The game ends after 40 correct clicks. Your next game starts at the distance where this one ended."
msgstr "Mỗi lần bấm đúng cho điểm nhân với khoảng cách. Ván kết thúc sau 40 lần bấm đúng. Ván sau của bạn bắt đầu ở khoảng cách mà ván này kết thúc."

#, elixir-autogen, elixir-format
msgid "Follow %{count} jet behind"
msgid_plural "Follow %{count} jets behind"
msgstr[0] "Đi theo chậm %{count} lượt"

#, elixir-autogen, elixir-format
msgid "Follow the leader octopus from cave to cave, some jets behind it. The better you follow, the further behind you jet (yes, that’s the reward)."
msgstr "Bơi theo chú bạch tuộc dẫn đầu từ hang này sang hang khác, chậm hơn nó vài lượt. Bạn theo càng giỏi thì càng bị bỏ xa (đúng vậy, đó là phần thưởng)."

#, elixir-autogen, elixir-format
msgid "Game over!"
msgstr "Hết ván!"

#, elixir-autogen, elixir-format
msgid "Ink Trail"
msgstr "Ink Trail"

#, elixir-autogen, elixir-format
msgid "Ink Trail is a Follow That Frog-like game. Lumosity and Follow That Frog are trademarks of Lumos Labs, Inc. Octomocto is not affiliated with Lumos Labs."
msgstr "Ink Trail là trò chơi giống Follow That Frog. Lumosity và Follow That Frog là nhãn hiệu của Lumos Labs, Inc. Octomocto không liên kết với Lumos Labs."

#, elixir-autogen, elixir-format
msgid "Ink Trail: a Sequence Memory Game Online"
msgstr "Ink Trail: trò chơi luyện trí nhớ làm việc online"

#, elixir-autogen, elixir-format
msgid "Joining the game…"
msgstr "Đang vào ván…"

#, elixir-autogen, elixir-format
