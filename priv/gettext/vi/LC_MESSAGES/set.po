#, elixir-autogen, elixir-format
msgid "27 cards, one feature is the same."
msgstr "27 lá, một đặc điểm giống nhau."

#, elixir-autogen, elixir-format
msgid "A set is 3 cards where each feature is the same on all 3 cards, or different on all 3 cards."
msgstr "Một bộ là 3 lá bài mà mỗi đặc điểm đều giống nhau trên cả 3 lá, hoặc đều khác nhau trên cả 3 lá."

#, elixir-autogen, elixir-format
msgid "All 81 cards."
msgstr "Đủ cả 81 lá."

#, elixir-autogen, elixir-format
msgid "All players look at the same table. The first player who claims a set gets the point."
msgstr "Mọi người chơi cùng nhìn một bàn. Ai lấy được bộ trước sẽ được điểm."

#, elixir-autogen, elixir-format
msgid "All players race on the same table. The game starts when all players are in."
msgstr "Mọi người chơi thi đua trên cùng một bàn. Ván bắt đầu khi tất cả người chơi đã vào."

